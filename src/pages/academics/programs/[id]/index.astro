---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import siteConfig from "../../../../../site.config.ts";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { pageMeta } from "../../../../lib/personalization.ts";
import AtAGlance from "../../../../components/AtAGlance.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import RequestInfoForm from "../../../../components/forms/RequestInfoForm.astro";
import EventList from "../../../../components/EventList.astro";
import ProgramHero from "../../../../components/programs/ProgramHero.astro";
import ProgramCareers from "../../../../components/programs/ProgramCareers.astro";
import { collegeOf, departmentOf, eventsForProgram, facultyInDepartment, hasEnded, relatedPrograms, storyOf } from "../../../../lib/catalog.ts";
import { listText, usd } from "../../../../lib/format.ts";
import { scenePhotos, storyPhotos } from "../../../../lib/photos.ts";
import { curriculum, programFaqs, programJsonLd } from "../../../../lib/program-page.ts";
import { pagePath, subjectPath } from "../../../../lib/urls.ts";
import { WORKBENCH_LABEL, WORKBENCH_PATH } from "../../../../lib/workbench/types.ts";

export const getStaticPaths = (async () => {
  const programs = await getCollection("programs");
  return programs.map((entry) => ({ params: { id: entry.id }, props: { program: entry.data } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { program: p } = Astro.props;
const path = pagePath("programs", p.id);
const department = departmentOf(p);
const related = relatedPrograms(p);
const upcoming = eventsForProgram(p).filter((e) => !hasEnded(e));
const { highlights, scene, story } = storyOf(p);
// The hero shows the description's first sentence; the rest introduces the highlights
const intro = p.description.replace(/^.*?[.?]\s+/, "");
const stages = curriculum(p);
const people = facultyInDepartment(department.id).slice(0, 3);
const faqs = programFaqs(p);
// Escaped so no text can close the script element
const jsonLd = JSON.stringify(programJsonLd(p, Astro.site!)).replace(/</g, "\\u003c");
---

<BaseLayout title={p.name} description={p.description} page={pageMeta.program(p)}>
  <script type="application/ld+json" set:html={jsonLd} />
  <Breadcrumb items={[{ label: "Programs", href: "/academics/programs/" }, { label: p.name, href: path }]} />
  <ProgramHero program={p} />
  <div class="detail">
    <article>
      <section class="why" aria-labelledby="why-title">
        <h2 id="why-title">Why study {department.field} at {siteConfig.shortName}</h2>
        {intro !== p.description && <p>{intro}</p>}
        <div class="why-grid">
          <ul class="highlights">
            {
              highlights.map((h) => (
                <li>
                  <strong>{h.title}</strong>
                  <span>{h.text}</span>
                </li>
              ))
            }
          </ul>
          <Picture class="scene" src={scenePhotos[scene].image} alt={scenePhotos[scene].alt} widths={[400, 640]} sizes="(min-width: 900px) 18rem, 100vw" formats={["avif", "webp"]} />
        </div>
      </section>

      <h2>What you'll learn</h2>
      <ul>{p.outcomes.map((o) => <li>{o}</li>)}</ul>

      <ProgramCareers program={p} />

      {
        stages.length > 0 && (
          <section aria-labelledby="study-title">
            <h2 id="study-title">What you'll study</h2>
            <div class="stages">
              {stages.map((stage) => (
                <div class="stage">
                  <h3>{stage.label}</h3>
                  <p class="stage-note">{stage.note}</p>
                  <ul>
                    {stage.courses.map((c) => (
                      <li>
                        <a href={pagePath("courses", c.id)}>
                          {c.code}: {c.title}
                        </a>{" "}
                        <span class="credits">{c.credits} credits</span>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}
            </div>
            <p>
              <a href={subjectPath(department.id)}>All {department.field} courses</a>
            </p>
          </section>
        )
      }

      {
        people.length > 0 && (
          <section aria-labelledby="faculty-title">
            <h2 id="faculty-title">Meet the faculty</h2>
            <ul class="people">
              {people.map((f) => (
                <li>
                  <a href={pagePath("faculty", f.id)}>{f.name}</a>
                  <span class="person-title">{f.role ?? f.title}</span>
                  <span>Works on {listText(f.research_interests.slice(0, 2))}</span>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section aria-labelledby="story-title">
        <h2 id="story-title">In their words</h2>
        <figure class="story">
          <Picture class="portrait" src={storyPhotos[story.photo]} alt="" widths={[160, 320]} sizes="8rem" formats={["avif", "webp"]} />
          <div>
            <blockquote><p>{story.quote}</p></blockquote>
            <figcaption><strong>{story.name}</strong>, {story.role}</figcaption>
          </div>
        </figure>
      </section>

      <h2>Admission requirements</h2>
      <ul>{p.requirements.map((r) => <li>{r}</li>)}</ul>

      {
        p.application_deadlines.length > 0 && (
          <>
            <h2>Application deadlines</h2>
            <ul>
              {p.application_deadlines.map((d) => (
                <li>
                  {d.term} start: {d.deadline}
                </li>
              ))}
            </ul>
          </>
        )
      }

      <section aria-labelledby="cost-title">
        <h2 id="cost-title">Cost and aid</h2>
        <p>
          Tuition is {usd(p.tuition_per_credit_usd)} per credit. At {p.credits} credits, that's about {usd(p.estimated_total_tuition_usd)} in total, before grants and
          scholarships.
        </p>
        <ul class="cost-links">
          <li><a href="/admissions/tuition-and-aid/">Tuition, financial aid, and scholarships</a></li>
          {siteConfig.features.workbench && <li><a href={WORKBENCH_PATH}>See your aid deadlines on {WORKBENCH_LABEL}</a></li>}
        </ul>
      </section>

      {
        upcoming.length > 0 && (
          <section aria-labelledby="events-title">
            <h2 id="events-title">Upcoming events</h2>
            <EventList events={upcoming} upcomingOnly limit={3} />
          </section>
        )
      }

      <section aria-labelledby="faq-title">
        <h2 id="faq-title">Questions people ask</h2>
        <div class="faqs">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.question}</summary>
                <p>{f.answer}</p>
              </details>
            ))
          }
        </div>
      </section>

      {
        related.length > 0 && (
          <>
            <h2>Related programs</h2>
            <ul>
              {related.map((r) => (
                <li>
                  <a href={pagePath("programs", r.id)}>{r.name}</a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </article>

    <div class="sidebar">
      <AtAGlance
        heading="At a glance"
        facts={[
          ["College", collegeOf(p).name],
          ["Department", department.name],
          ["Campus", p.campus],
          ["Starts", p.start_terms.join(", ")],
          ["Credits", String(p.credits)],
          ["Tuition", `${usd(p.tuition_per_credit_usd)} per credit`],
          ["Transfer credit", p.accepts_transfer_credit ? "Accepted" : "Not accepted"],
        ]}
      />
      <RequestInfoForm id="request-info" program={p} compact />
    </div>
  </div>
</BaseLayout>

<script>
  import "../../../../scripts/past-events.ts";
</script>

<style>
  /* At a glance, then the request-info form */
  .sidebar { display: grid; gap: 1.5rem; align-content: start; }

  .why-grid { display: grid; gap: 1.25rem; align-items: start; }
  @media (min-width: 40rem) { .why-grid { grid-template-columns: minmax(0, 1fr) minmax(0, 16rem); } }
  .highlights { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.85rem; }
  .highlights li { display: grid; gap: 0.15rem; padding-left: 1rem; border-left: 4px solid var(--fir); }
  .why :global(.scene) { width: 100%; height: auto; aspect-ratio: 4 / 3; object-fit: cover; border-radius: var(--radius-s); }

  .stages { display: grid; gap: 1rem 2rem; }
  @media (min-width: 40rem) { .stages { grid-template-columns: 1fr 1fr; } }
  .stage h3 { margin: 0; font-size: var(--step-1); }
  .stage-note { margin: 0.15rem 0 0.5rem; font-size: var(--step--1); color: var(--muted); }
  .stage ul { padding-left: 1.1rem; }
  .credits { font-size: var(--step--1); color: var(--muted); white-space: nowrap; }

  .people { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr)); gap: 1rem; }
  .people li { display: grid; gap: 0.2rem; padding: 1rem 1.1rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-s); }
  .people a { font-weight: 700; }
  .person-title { font-size: var(--step--1); font-weight: 600; }
  .people li span:last-child { font-size: var(--step--1); color: var(--muted); }

  .story { display: grid; grid-template-columns: 6rem minmax(0, 1fr); gap: 1.25rem; align-items: start; margin: 1rem 0 0; padding: 1.25rem; background: var(--paper); border-left: 6px solid var(--fir); border-radius: var(--radius-s); }
  @media (min-width: 40rem) { .story { grid-template-columns: 8rem minmax(0, 1fr); } }
  .story :global(.portrait) { width: 100%; height: auto; aspect-ratio: 1; object-fit: cover; object-position: 50% 15%; border-radius: 50%; }
  .story blockquote { margin: 0 0 0.75rem; font: italic var(--step-1) / 1.45 var(--serif); }
  .story blockquote p { margin: 0; }
  .story figcaption { font-size: var(--step--1); color: var(--muted); }

  .cost-links { padding-left: 1.1rem; }

  .faqs { border-top: 1px solid var(--line); }
  .faqs details { border-bottom: 1px solid var(--line); }
  .faqs summary { padding: 0.85rem 0; font-weight: 600; cursor: pointer; min-height: 24px; }
  .faqs details p { margin: 0 0 1rem; max-width: var(--measure); }
</style>
