---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { pageMeta } from "../../../../lib/personalization.ts";
import AtAGlance from "../../../../components/AtAGlance.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import EventList from "../../../../components/EventList.astro";
import { collegeOf, departmentOf, eventsForProgram, hasEnded, relatedCourses, relatedPrograms } from "../../../../lib/catalog.ts";
import { listText, usd } from "../../../../lib/format.ts";
import { pagePath, subjectPath } from "../../../../lib/urls.ts";

export const getStaticPaths = (async () => {
  const programs = await getCollection("programs");
  return programs.map((entry) => ({ params: { id: entry.id }, props: { program: entry.data } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { program: p } = Astro.props;
const path = pagePath("programs", p.id);
const department = departmentOf(p);
const related = relatedPrograms(p);
const sampleCourses = relatedCourses(p).slice(0, 8);
const upcoming = eventsForProgram(p).filter((e) => !hasEnded(e));
---

<BaseLayout title={p.name} description={p.description} page={pageMeta.program(p)}>
  <Breadcrumb items={[{ label: "Programs", href: "/academics/programs/" }, { label: p.name, href: path }]} />
  <div class="detail">
    <article>
      <h1>{p.name}</h1>
      <p class="lede">{p.description}</p>

      <h2>What you'll learn</h2>
      <ul>{p.outcomes.map((o) => <li>{o}</li>)}</ul>

      <h2>Careers</h2>
      <p>Common careers include {listText(p.careers)}.</p>

      <h2>Admission requirements</h2>
      <ul>{p.requirements.map((r) => <li>{r}</li>)}</ul>

      {
        p.application_deadlines.length > 0 && (
          <>
            <h2>Application deadlines</h2>
            <ul>{p.application_deadlines.map((d) => <li>{d.term} start: {d.deadline}</li>)}</ul>
          </>
        )
      }

      {
        sampleCourses.length > 0 && (
          <>
            <h2>Sample courses</h2>
            <ul>
              {sampleCourses.map((c) => (
                <li><a href={pagePath("courses", c.id)}>{c.code}: {c.title}</a></li>
              ))}
            </ul>
            <p><a href={subjectPath(department.id)}>All {department.field} courses</a></p>
          </>
        )
      }

      {
        upcoming.length > 0 && (
          <section aria-labelledby="events-title">
            <h2 id="events-title">Upcoming events</h2>
            <EventList events={upcoming} upcomingOnly limit={3} />
          </section>
        )
      }

      {
        related.length > 0 && (
          <>
            <h2>Related programs</h2>
            <ul>{related.map((r) => <li><a href={pagePath("programs", r.id)}>{r.name}</a></li>)}</ul>
          </>
        )
      }
    </article>

    <AtAGlance
      heading="At a glance"
      facts={[
        ["Credential", p.credential],
        ["College", collegeOf(p).name],
        ["Department", department.name],
        ["Format", p.modality],
        ["Campus", p.campus],
        ["Starts", p.start_terms.join(", ")],
        ["Length", p.duration],
        ["Credits", String(p.credits)],
        ["Tuition", `${usd(p.tuition_per_credit_usd)} per credit, about ${usd(p.estimated_total_tuition_usd)} total`],
        ["Transfer credit", p.accepts_transfer_credit ? "Accepted" : "Not accepted"],
      ]}
    />
  </div>
</BaseLayout>

<script>
  import "../../../../scripts/past-events.ts";
</script>
