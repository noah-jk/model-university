---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import siteConfig from "../../../../site.config.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AskAiMenu from "../../../components/AskAiMenu.astro";
import AtAGlance from "../../../components/AtAGlance.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import EventList from "../../../components/EventList.astro";
import { eventsAbout, hasEnded } from "../../../lib/catalog.ts";
import { formatHours } from "../../../lib/hours.ts";
import { markdownPath, pagePath } from "../../../lib/urls.ts";
import { DAYS, DAY_NAMES } from "../../../lib/vocab.ts";

export const getStaticPaths = (async () => {
  const services = await getCollection("services");
  return services.map((entry) => ({ params: { id: entry.id }, props: { service: entry.data } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { service: s } = Astro.props;
const path = pagePath("services", s.id);
const upcoming = eventsAbout("services", s.id).filter((e) => !hasEnded(e));
---

<BaseLayout title={s.name} description={s.description}>
  <Breadcrumb items={[{ label: "Student services", href: "/services/" }, { label: s.name, href: path }]} />
  <div class="detail">
    <article>
      <h1>{s.name}</h1>
      <p class="lede">{s.description}</p>
      <AskAiMenu
        prompt={`Read {origin}${path} and help me use the ${s.name} at ${siteConfig.name}.`}
        markdown={markdownPath("services", s.id)}
        label="Ask AI about this service"
      />

      <h2>Hours</h2>
      <div class="table-scroll">
        <table>
          <caption class="visually-hidden">Weekly hours, Pacific time</caption>
          <tbody>
            {
              DAYS.map((d) => (
                <tr>
                  <th scope="row">{DAY_NAMES[d]}</th>
                  <td>{formatHours(s.hours[d])}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      <h2>Who can use it</h2>
      <p>
        {s.eligibility}.{s.appointment_required ? " Appointments are required." : " Drop in anytime during open hours."}
        {s.virtual_option && " Virtual appointments are available."}
      </p>

      {
        upcoming.length > 0 && (
          <section aria-labelledby="events-title">
            <h2 id="events-title">Upcoming events</h2>
            <EventList events={upcoming} upcomingOnly limit={3} />
          </section>
        )
      }
    </article>

    <AtAGlance
      heading="Contact"
      facts={[
        ["Location", `${s.location}, ${s.campus}`],
        ["Phone", { text: s.phone, href: `tel:+1${s.phone.replace(/\D/g, "")}` }],
        ["Email", { text: s.email, href: `mailto:${s.email}` }],
        ["Category", s.category],
      ]}
    />
  </div>
</BaseLayout>

<script>
  import "../../../scripts/past-events.ts";
</script>

<style>
  table { max-width: 28rem; }
</style>
