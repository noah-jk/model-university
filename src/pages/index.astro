---
import { getCollection } from "astro:content";
import { Picture } from "astro:assets";
import campus from "../assets/images/campus.jpg";
import students from "../assets/images/students-class-5.jpg";
import siteConfig from "../../site.config.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import AskAiMenu from "../components/AskAiMenu.astro";
import McpAddress from "../components/McpAddress.astro";
import EventList from "../components/EventList.astro";
import NextStep from "../components/NextStep.astro";
import NewsList from "../components/NewsList.astro";
import { events, hasEnded } from "../lib/catalog.ts";

const [programs, courses, services, colleges] = await Promise.all([
  getCollection("programs"),
  getCollection("courses"),
  getCollection("services"),
  getCollection("colleges"),
]);
const latestNews = (await getCollection("news")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const faculty = await getCollection("faculty");
const stats: [string, string][] = [
  [String(programs.length), "Degrees, minors, and certificates"],
  [courses.length.toLocaleString("en-US"), "Courses to choose from"],
  [String(colleges.length), "Colleges"],
  [String(faculty.length), "Faculty teaching and mentoring"],
];
const upcoming = events.filter((e) => !hasEnded(e));

const prompt = `Help me find a program at ${siteConfig.name} using {origin}/llms.txt. If I haven't said what I want, ask me one short question about my interests. Once I've given any preference, recommend the top 3 matches with links and don't keep asking questions.`;
---

<BaseLayout title={siteConfig.name} description={`Programs, courses, and student services at ${siteConfig.name}, available to AI assistants.`}>
  <section class="hero" aria-labelledby="hero-title">
    <Picture src={campus} formats={["avif", "webp"]} widths={[640, 960, 1200]} sizes="100vw" alt="Brick and stone campus building with a green lawn in front, on a sunny morning" loading="eager" fetchpriority="high" />
    <div class="hero-inner">
      <h1 id="hero-title">Build a Future Here</h1>
      <p class="lede">
        Explore {programs.length} degrees, minors, and certificates at {siteConfig.name}. Our programs, courses, and student services are also available to AI assistants like Claude and ChatGPT, straight from the source.
      </p>
      <div class="page-actions">
        <a class="button primary" href="/academics/programs/">Browse programs</a>
        <AskAiMenu prompt={prompt} label="Ask your AI about Cascadia State" />
      </div>
    </div>
  </section>

  {
    siteConfig.features.personalization && (
      <section id="home-next-step" class="next-step" aria-label="Your next step">
        <NextStep headingLevel="h2" wide />
      </section>
    )
  }

  <section class="split" aria-labelledby="split-title">
    <div class="split-text">
      <h2 id="split-title">An Education Built for the Northwest and Beyond</h2>
      <p>
        Cascadia State students learn in small classes, work on real projects with regional employers, and are taught by faculty who put teaching first. Whatever you choose to study, you'll leave ready to do the work.
      </p>
      <dl class="stats">
        {
          stats.map(([value, label]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <p><a class="button secondary" href="/academics/">Explore academics</a></p>
    </div>
    <figure class="split-image">
      <Picture src={students} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 48rem) 50vw, 100vw" alt="Three students laughing together over a notebook in a library" />
    </figure>
  </section>

  <section class="explore" aria-label="Explore the catalog">
    <a href="/academics/programs/">
      <h2>Programs</h2>
      <p>{programs.length} degrees, minors, and certificates across {colleges.length} colleges.</p>
    </a>
    <a href="/academics/courses/">
      <h2>Courses</h2>
      <p>{courses.length.toLocaleString("en-US")} courses with terms, formats, and prerequisites.</p>
    </a>
    <a href="/services/">
      <h2>Student services</h2>
      <p>{services.length} offices, from tutoring to the food pantry, with weekly hours.</p>
    </a>
  </section>

  <div class="happening">
    <section aria-labelledby="events-title">
      <h2 id="events-title">Upcoming events</h2>
      <EventList events={upcoming} upcomingOnly limit={3} />
      <p><a href="/about/events/">All events</a></p>
    </section>
    <section aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      <NewsList stories={latestNews} />
      <p><a href="/about/news/">All news</a></p>
    </section>
  </div>

  {
    siteConfig.features.mcp && (
      <section class="panel connect" aria-labelledby="connect-title">
        <h2 id="connect-title">Connect the whole catalog to your AI</h2>
        <p>Add this address as a connector in Claude, ChatGPT, Cursor, or any app that supports MCP. Your assistant can then search programs, compare costs, and check service hours for you.</p>
        <McpAddress />
        <p><a href="/connect/">Step-by-step setup for each app</a></p>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Full-width banner: break out of the page column. The photo sits under a
     dark gradient so the white text clears 4.5:1 even over the bright sky. */
  :global(body) { overflow-x: clip; }
  .hero {
    position: relative; isolation: isolate; display: flex; align-items: flex-end;
    width: 100vw; margin: calc(-1 * clamp(2rem, 6vw, 4rem)) calc(50% - 50vw) 4rem;
    min-height: clamp(26rem, 62vh, 40rem); color: #fff; background: var(--fir-deep);
  }
  .hero :global(img) { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: center 35%; }
  .hero::before {
    content: ""; position: absolute; inset: 0; z-index: -1;
    background: linear-gradient(90deg, rgb(10 24 20 / 0.88) 0%, rgb(10 24 20 / 0.72) 55%, rgb(10 24 20 / 0.45) 100%),
      linear-gradient(0deg, rgb(10 24 20 / 0.6), transparent 60%);
  }
  .hero-inner { width: 100%; max-width: var(--wrap); margin-inline: auto; padding: clamp(3rem, 8vw, 6rem) clamp(1rem, 4vw, 2.5rem); }
  h1 { font-size: clamp(2.75rem, 8vw, 5.5rem); line-height: 1.02; max-width: 12ch; margin-bottom: 0.3em; text-shadow: 0 2px 18px rgb(0 0 0 / 0.35); }
  .hero .lede { color: #fff; max-width: 40rem; }
  .hero .button.primary { background: #fff; border-color: #fff; color: var(--basalt); }
  .hero .button.primary:hover { background: var(--lichen); border-color: var(--lichen); }
  .hero :global(.ai-menu-toggle) { background: transparent; border-color: #fff; color: #fff; }
  .hero :global(.ai-menu-toggle:hover) { background: rgb(255 255 255 / 0.16); border-color: #fff; color: #fff; }
  .hero :global(a:focus-visible), .hero :global(button:focus-visible) { outline-color: #fff; }

  .next-step { margin-bottom: 4rem; }

  .split { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; margin-bottom: 4rem; }
  @media (min-width: 48rem) { .split { grid-template-columns: 1fr 1fr; } }
  .split h2 { font-size: var(--step-3); margin-bottom: 0.5em; }
  .split-text > p { color: var(--muted); max-width: 36rem; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; margin: 2rem 0; }
  .stats div { border-top: 3px solid var(--fir); padding-top: 0.5rem; display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-family: var(--serif); font-size: var(--step-4); line-height: 1; }
  .stats dt { color: var(--muted); font-size: var(--step--1); margin-top: 0.35rem; }
  .split-image { margin: 0; }
  .split-image :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 40%; border-radius: var(--radius-l); }

  .explore { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-bottom: 4rem; }
  .explore a { display: block; color: inherit; text-decoration: none; padding: 1.25rem 0 0; border-top: 3px solid var(--fir); }
  .explore a:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .explore h2 { font-size: var(--step-2); margin-bottom: 0.25em; }
  .explore p { color: var(--muted); margin: 0; }

  .happening { display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); margin-bottom: 4rem; }
  .happening h2 { font-size: var(--step-2); padding-top: 1rem; border-top: 3px solid var(--fir); }
  .happening p { margin-top: 1rem; }
  .connect { border-left: 6px solid var(--fir); }
</style>

<script>
  import "../scripts/past-events.ts";
  import "../scripts/home-next-step.ts";
</script>
