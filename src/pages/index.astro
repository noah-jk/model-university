---
import { getCollection } from "astro:content";
import siteConfig from "../../site.config.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import ForYou from "../components/ForYou.astro";
import AskAiMenu from "../components/AskAiMenu.astro";
import McpAddress from "../components/McpAddress.astro";
import EventList from "../components/EventList.astro";
import NewsList from "../components/NewsList.astro";
import { events, hasEnded } from "../lib/catalog.ts";

const [programs, courses, services, colleges] = await Promise.all([
  getCollection("programs"),
  getCollection("courses"),
  getCollection("services"),
  getCollection("colleges"),
]);
const latestNews = (await getCollection("news")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()).slice(0, 3);
const upcoming = events.filter((e) => !hasEnded(e));

const prompt = `Help me find a program at ${siteConfig.name} using {origin}/llms.txt. If I haven't said what I want, ask me one short question about my interests. Once I've given any preference, recommend the top 3 matches with links and don't keep asking questions.`;
---

<BaseLayout title={siteConfig.name} description={`Programs, courses, and student services at ${siteConfig.name}, available to AI assistants.`}>
  <section class="hero" aria-labelledby="hero-title">
    <div>
      <h1 id="hero-title">{siteConfig.shortName}</h1>
      <p class="lede">
        Our programs, courses, and student services are available to AI assistants like Claude and ChatGPT, straight from the source. Ask in your own words and get answers from official information.
      </p>
      <div class="page-actions">
        <AskAiMenu prompt={prompt} label="Ask your AI about Cascadia State" />
        <a class="button secondary" href="/academics/programs/">Browse programs</a>
      </div>
    </div>
    <figure>
      <img src="/images/campus.jpg" width="1200" height="786" alt="Brick and stone campus building with a green lawn in front, on a sunny morning" />
    </figure>
  </section>

  <ForYou recommend />

  <section class="explore" aria-label="Explore the catalog">
    <a href="/academics/programs/">
      <h2>Programs</h2>
      <p>{programs.length} degrees, minors, and certificates across {colleges.length} colleges.</p>
    </a>
    <a href="/academics/courses/">
      <h2>Courses</h2>
      <p>{courses.length.toLocaleString("en-US")} courses with terms, formats, and prerequisites.</p>
    </a>
    <a href="/services/">
      <h2>Student services</h2>
      <p>{services.length} offices, from tutoring to the food pantry, with weekly hours.</p>
    </a>
  </section>

  <div class="happening">
    <section aria-labelledby="events-title">
      <h2 id="events-title">Upcoming events</h2>
      <EventList events={upcoming} upcomingOnly limit={3} />
      <p><a href="/about/events/">All events</a></p>
    </section>
    <section aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      <NewsList stories={latestNews} />
      <p><a href="/about/news/">All news</a></p>
    </section>
  </div>

  {
    siteConfig.features.mcp && (
      <section class="panel connect" aria-labelledby="connect-title">
        <h2 id="connect-title">Connect the whole catalog to your AI</h2>
        <p>Add this address as a connector in Claude, ChatGPT, Cursor, or any app that supports MCP. Your assistant can then search programs, compare costs, and check service hours for you.</p>
        <McpAddress />
        <p><a href="/connect/">Step-by-step setup for each app</a></p>
      </section>
    )
  }
</BaseLayout>

<style>
  .hero { display: grid; gap: clamp(2rem, 5vw, 4rem); grid-template-columns: 1fr; align-items: center; margin-bottom: 4rem; }
  @media (min-width: 860px) { .hero { grid-template-columns: 1.1fr 1fr; } }
  h1 { font-size: clamp(2rem, 5vw, 3.5rem); margin-bottom: 0.35em; }
  figure { margin: 0; }
  img { display: block; width: 100%; height: auto; border-radius: var(--radius-l); }

  .explore { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); margin-bottom: 4rem; }
  .explore a { display: block; color: inherit; text-decoration: none; padding: 1.25rem 0 0; border-top: 3px solid var(--fir); }
  .explore a:hover h2 { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.15em; }
  .explore h2 { font-size: var(--step-2); margin-bottom: 0.25em; }
  .explore p { color: var(--muted); margin: 0; }

  .happening { display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); margin-bottom: 4rem; }
  .happening h2 { font-size: var(--step-2); padding-top: 1rem; border-top: 3px solid var(--fir); }
  .happening p { margin-top: 1rem; }
  .connect { border-left: 6px solid var(--fir); }
</style>

<script>
  import "../scripts/past-events.ts";
</script>
