---
import { getCollection } from "astro:content";
import { Picture, getImage } from "astro:assets";
import campus from "../assets/images/campus.jpg";
import students from "../assets/images/students-class-5.jpg";
import siteConfig from "../../site.config.ts";
import BaseLayout from "../layouts/BaseLayout.astro";
import AskAiMenu from "../components/AskAiMenu.astro";
import McpAddress from "../components/McpAddress.astro";
import EventList from "../components/EventList.astro";
import NextStep from "../components/NextStep.astro";
import PathHandoff from "../components/workbench/PathHandoff.astro";
import NewsList from "../components/NewsList.astro";
import { events, hasEnded } from "../lib/catalog.ts";
import { collegePhotos } from "../lib/photos.ts";
import { careers, services } from "../lib/catalog.ts";
import { careerOptions, serviceGroups } from "../lib/discover.ts";
import { COLLEGE_HEADLINES, PROFILE_KEY } from "../lib/personalization-settings.ts";
import { SECTION_PATH } from "../lib/urls.ts";

const [programs, courses, colleges] = await Promise.all([
  getCollection("programs"),
  getCollection("courses"),
  getCollection("colleges"),
]);
// All stories, newest first; three show, and home-audience.ts may pick others
const latestNews = (await getCollection("news")).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const faculty = await getCollection("faculty");
const stats: [string, string][] = [
  [String(programs.length), "Degrees, minors, and certificates"],
  [courses.length.toLocaleString("en-US"), "Courses to choose from"],
  [String(colleges.length), "Colleges"],
  [String(faculty.length), "Faculty teaching and mentoring"],
];
// Hero photo for the college a visitor has looked at most (the headline for
// each college is in src/lib/personalization-settings.ts). Only the default
// photo is in the page. These are built here and listed as JSON, and
// src/scripts/home-audience.ts fetches just the one that's needed.
const heroWidths = [640, 960, 1280, 1920];
const srcset = async (image: ImageMetadata, format: "avif" | "webp" | "jpeg") =>
  (await Promise.all(heroWidths.map(async (width) => `${(await getImage({ src: image, width, format })).src} ${width}w`))).join(", ");
const heroImages = Object.fromEntries(
  await Promise.all(
    Object.entries(collegePhotos).map(async ([college, { image, alt }]) => [
      college,
      { alt, avif: await srcset(image, "avif"), webp: await srcset(image, "webp"), jpeg: await srcset(image, "jpeg") },
    ]),
  ),
);

// The hero photo's box: beside the text on wide screens, under it on narrow ones
const heroSizes = "(min-width: 56rem) 34rem, 100vw";
const defaultHeadline = "Build a Future Here";

const upcoming = events.filter((e) => !hasEnded(e));
const admissionsEvents = upcoming.filter((e) => e.category === "Admissions");

const prompt = `Help me find a program at ${siteConfig.name} using {origin}/llms.txt. If I haven't said what I want, ask me one short question about my interests. Once I've given any preference, recommend the top 3 matches with links and don't keep asking questions.`;
---

<BaseLayout title={siteConfig.name} description={`Programs, courses, and student services at ${siteConfig.name}, available to AI assistants.`}>
  <section class="hero texture-topo" aria-labelledby="hero-title">
    <div class="hero-inner">
      <div class="hero-text">
        <h1 id="hero-title" data-default={defaultHeadline}>{defaultHeadline}</h1>
        {
          siteConfig.features.personalization && (
            <script is:inline define:vars={{ key: PROFILE_KEY, headlines: COLLEGE_HEADLINES }}>
              // The headline for the college this tab has looked at most, set before
              // the page is drawn so it never changes in view. The same choice as
              // preferred() in personalize.ts: a form answer, else the most viewed.
              // home-audience.ts takes over from here (and swaps the photo).
              try {
                const profile = JSON.parse(sessionStorage.getItem(key) || "null")?.profile;
                const viewed = Object.entries(profile?.college || {}).sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0]))[0]?.[0];
                const college = profile?.stated?.college || viewed;
                if (headlines[college]) document.getElementById("hero-title").textContent = headlines[college];
              } catch {}
            </script>
          )
        }
        <p class="lede">
          Explore {programs.length} degrees, minors, and certificates at {siteConfig.name}. Our programs, courses, and student services are also available to AI assistants like Claude and ChatGPT, straight from the source.
        </p>
        <div class="page-actions">
          <a class="button primary" href="/academics/programs/">Browse programs</a>
          <AskAiMenu prompt={prompt} label="Ask your AI about Cascadia State" />
        </div>
      </div>
      <div class="hero-photo">
        <script is:inline type="application/json" id="hero-images" set:html={JSON.stringify(heroImages)} />
        <Picture src={campus} formats={["avif", "webp"]} widths={[640, 960, 1200]} sizes={heroSizes} alt="Brick and stone campus building with a green lawn in front, on a sunny morning" loading="eager" fetchpriority="high" pictureAttributes={{ id: "hero-picture" }} />
      </div>
    </div>
  </section>

  <section class="discover texture-foliage" aria-labelledby="discover-title">
    <div class="discover-inner">
      <form class="discover-card" action={`${SECTION_PATH.careers}/`} method="get" data-discover>
        <h2 id="discover-title">Discover your path</h2>
        <div class="discover-fields">
          <div class="field">
            <label for="discover-career">Career</label>
            <div class="combo">
              <input id="discover-career" name="q" type="text" role="combobox" aria-expanded="false" aria-controls="discover-careers" aria-autocomplete="list" autocomplete="off" spellcheck="false" placeholder="For example, nurse" />
              <ul id="discover-careers" role="listbox" aria-label="Matching careers" hidden></ul>
            </div>
          </div>
          <div class="field">
            <label for="discover-service">I need help with</label>
            <select id="discover-service" name="service">
              <option value="">Choose a service</option>
              {
                serviceGroups(services).map((g) => (
                  <optgroup label={g.category}>
                    {g.services.map((s) => (
                      <option value={s.url}>{s.name}</option>
                    ))}
                  </optgroup>
                ))
              }
            </select>
          </div>
          <button type="submit" class="button arrow">Go</button>
        </div>
      </form>
      <script is:inline type="application/json" id="discover-career-options" set:html={JSON.stringify(careerOptions(careers))} />
    </div>
  </section>

  {
    siteConfig.features.personalization && (
      <section id="home-next-step" class="next-step" aria-label="Your next step">
        <NextStep headingLevel="h2" wide />
      </section>
    )
  }
  <PathHandoff id="home" hideWhenContinuing={siteConfig.features.personalization} />

  <section class="split" aria-labelledby="split-title">
    <div class="split-text">
      <p class="eyebrow">Why Cascadia State</p>
      <h2 id="split-title">An Education Built for the Northwest and Beyond</h2>
      <p>
        Cascadia State students learn in small classes, work on real projects with regional employers, and are taught by faculty who put teaching first. Whatever you choose to study, you'll leave ready to do the work.
      </p>
      <dl class="stats">
        {
          stats.map(([value, label]) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      <p><a class="button secondary" href="/academics/">Explore academics</a></p>
    </div>
    <figure class="split-image">
      <Picture src={students} formats={["avif", "webp"]} widths={[480, 720, 960]} sizes="(min-width: 48rem) 50vw, 100vw" alt="Three students laughing together over a notebook in a library" />
    </figure>
  </section>

  <div class="happening" id="home-news-events">
    <section aria-labelledby="events-title">
      <h2 id="events-title">Upcoming events</h2>
      <EventList events={upcoming} upcomingOnly limit={3} />
      <p><a href="/about/events/">All events</a></p>
    </section>
    <section aria-labelledby="news-title">
      <h2 id="news-title">News</h2>
      <NewsList stories={latestNews} limit={3} />
      <p><a href="/about/news/">All news</a></p>
    </section>
  </div>

  {
    siteConfig.features.personalization && (
      <section id="home-admissions-events" class="admissions-events" aria-labelledby="admissions-events-title" hidden>
        <h2 id="admissions-events-title">Admissions events</h2>
        <EventList events={admissionsEvents} upcomingOnly limit={3} columns />
        <p><a href="/admissions/visit/">Visit campus</a> · <a href="/about/events/">All events</a></p>
      </section>
    )
  }

  {
    siteConfig.features.mcp && (
      <section class="panel connect" aria-labelledby="connect-title">
        <h2 id="connect-title">Connect the whole catalog to your AI</h2>
        <p>Add this address as a connector in Claude, ChatGPT, Cursor, or any app that supports MCP. Your assistant can then search programs, compare costs, and check service hours for you.</p>
        <McpAddress />
        <p><a href="/connect/">Step-by-step setup for each app</a></p>
      </section>
    )
  }
</BaseLayout>

<style>
  /* Full-width bands: break out of the page column */
  :global(body) { overflow-x: clip; }
  .hero, .discover { width: var(--page-width); margin-inline: calc(50% - var(--page-width) / 2); }
  .hero-inner, .discover-inner { max-width: var(--wrap); margin-inline: auto; padding-inline: clamp(1rem, 4vw, 2.5rem); }

  /* Hero: contours on sage, the headline and the one yellow action, and the
     college photo, which hangs over the hero's bottom edge into the band below */
  .hero { margin-top: calc(-1 * clamp(2rem, 6vw, 4rem)); z-index: 1; }
  .hero-inner { display: grid; gap: 2rem; padding-block: clamp(2.5rem, 7vw, 5rem) 0; }
  @media (min-width: 56rem) { .hero-inner { grid-template-columns: minmax(0, 1fr) 34rem; align-items: end; gap: 3rem; } }
  .hero-text { padding-bottom: clamp(1rem, 4vw, 3.5rem); }
  h1 { font-size: clamp(2.75rem, 6.5vw, 4.75rem); line-height: 1.02; max-width: 14ch; margin-bottom: 0.3em; }
  .hero .lede { color: var(--basalt); max-width: 36rem; }
  .hero-photo { position: relative; aspect-ratio: 4 / 3; margin-bottom: -3rem; border-radius: var(--radius-s); overflow: hidden; background: var(--mist); box-shadow: 0 10px 30px rgb(0 0 0 / 0.18); }
  .hero-photo :global(img) { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  /* A college photo fades in over the default one (home-audience.ts) */
  .hero :global(picture.incoming img) { opacity: 0; transition: opacity 0.7s ease; }
  .hero :global(picture.incoming.in img) { opacity: 1; }
  @media (prefers-reduced-motion: reduce) { .hero :global(picture.incoming img) { transition: none; } }

  /* Discover: halftone foliage with a solid card on top (no text on the foliage itself) */
  .discover { margin-bottom: 4rem; padding-block: calc(3rem + clamp(2rem, 5vw, 3.5rem)) clamp(2rem, 5vw, 3.5rem); }
  .discover-card { background: var(--paper); border-radius: var(--radius-s); padding: clamp(1.25rem, 3vw, 2rem); box-shadow: 0 8px 28px rgb(0 0 0 / 0.2); max-width: 56rem; }
  .discover-card h2 { font-size: var(--step-3); margin: 0 0 1rem; }
  .discover-fields { display: grid; gap: 1rem; align-items: end; }
  @media (min-width: 48rem) { .discover-fields { grid-template-columns: 1fr 1fr auto; } }
  .discover .field label { display: block; font-weight: 600; margin-bottom: 0.35rem; }
  /* The same height for the field, the list, and Go, so they line up */
  .discover .field input, .discover .field select, .discover .button { height: 3rem; min-height: 3rem; }
  .combo { position: relative; }
  .combo ul { position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 2px); max-height: 18rem; overflow-y: auto; margin: 0; padding: 0.25rem 0; list-style: none; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-s); box-shadow: 0 8px 24px rgb(0 0 0 / 0.16); }
  .combo :global([role="option"]) { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 0 0.75rem; padding: 0.55rem 0.75rem; cursor: pointer; }
  .combo :global([role="option"]:hover), .combo :global([role="option"][aria-selected="true"]) { background: var(--mist); color: var(--fir); }
  /* The highlighted suggestion is marked by more than color */
  .combo :global([role="option"][aria-selected="true"]) { box-shadow: inset 3px 0 0 var(--fir); font-weight: 600; }
  .combo :global(.option-meta) { color: var(--muted); font-size: var(--step--1); font-weight: 400; }

  .next-step { margin-bottom: 4rem; }

  .split { display: grid; gap: clamp(2rem, 5vw, 4rem); align-items: center; margin-bottom: 4rem; }
  @media (min-width: 48rem) { .split { grid-template-columns: 1fr 1fr; } }
  .split h2 { font-size: var(--step-3); margin-bottom: 0.5em; }
  .split-text > p { color: var(--muted); max-width: 36rem; }
  .stats { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.5rem 2rem; margin: 2rem 0; }
  .stats div { border-top: 3px solid var(--fir); padding-top: 0.5rem; display: flex; flex-direction: column-reverse; }
  .stats dd { margin: 0; font-family: var(--serif); font-size: var(--step-4); line-height: 1; color: var(--heading); }
  .stats dt { color: var(--muted); font-size: var(--step--1); margin-top: 0.35rem; }
  .split-image { margin: 0; }
  .split-image :global(img) { width: 100%; aspect-ratio: 3 / 4; object-fit: cover; object-position: 50% 40%; border-radius: var(--radius-s); }

  .happening { display: grid; gap: 2rem 3rem; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); margin-bottom: 4rem; }
  .happening h2 { font-size: var(--step-2); padding-top: 1rem; border-top: 3px solid var(--fir); }
  .happening p { margin-top: 1rem; }
  .admissions-events { margin-bottom: 4rem; }
  .admissions-events h2 { font-size: var(--step-2); padding-top: 1rem; border-top: 3px solid var(--fir); }
  .admissions-events > p { margin-top: 1rem; }
  .connect { border-top: 3px solid var(--fir); }
</style>

<script>
  import "../scripts/past-events.ts";
  import "../scripts/home-next-step.ts";
  import "../scripts/home-audience.ts";
  import "../scripts/discover.ts";
</script>
