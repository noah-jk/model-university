---
import { getPage } from "../../lib/pages.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import AtAGlance from "../../components/AtAGlance.astro";
import { colleges, courses, departments, faculty, programs, services } from "../../lib/catalog.ts";

const page = await getPage("about");
const { Content } = page;
---

<BaseLayout title={page.title} description={page.description}>
  <div class="detail">
    <article>
      <h1>{page.title}</h1>
      <p class="lede">{page.description}</p>
      <Content />

      <h2>Colleges</h2>
      <dl class="colleges">
        {
          colleges.map((c) => (
            <>
              <dt>{c.name}</dt>
              <dd>{c.description}</dd>
            </>
          ))
        }
      </dl>
    </article>

    <AtAGlance
      heading="By the numbers"
      facts={[
        ["Campuses", "Tacoma Bay, Olympia, and online"],
        ["Colleges", String(colleges.length)],
        ["Departments", String(departments.length)],
        ["Programs", { text: String(programs.length), href: "/academics/programs/" }],
        ["Courses", { text: courses.length.toLocaleString("en-US"), href: "/academics/courses/" }],
        ["Faculty", { text: String(faculty.length), href: "/about/faculty/" }],
        ["Student services", { text: String(services.length), href: "/services/" }],
      ]}
    />
  </div>
</BaseLayout>

<style>
  .colleges dt { font-weight: 600; margin-top: 1rem; }
  .colleges dd { margin: 0.25rem 0 0; max-width: var(--measure); }
</style>
