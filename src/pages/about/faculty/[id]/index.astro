---
import type { GetStaticPaths, InferGetStaticPropsType } from "astro";
import { getCollection } from "astro:content";
import siteConfig from "../../../../../site.config.ts";
import BaseLayout from "../../../../layouts/BaseLayout.astro";
import { pageMeta } from "../../../../lib/personalization.ts";
import AtAGlance from "../../../../components/AtAGlance.astro";
import Breadcrumb from "../../../../components/Breadcrumb.astro";
import EventList from "../../../../components/EventList.astro";
import { coursesTaughtBy, departmentOf, eventsAbout, hasEnded } from "../../../../lib/catalog.ts";
import { pagePath, subjectPath } from "../../../../lib/urls.ts";

export const getStaticPaths = (async () => {
  const people = await getCollection("faculty");
  return people.map((entry) => ({ params: { id: entry.id }, props: { person: entry.data } }));
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { person: f } = Astro.props;
const path = pagePath("faculty", f.id);
const department = departmentOf(f);
const courses = coursesTaughtBy(f.id).sort((a, b) => a.code.localeCompare(b.code, undefined, { numeric: true }));
const upcoming = eventsAbout("faculty", f.id).filter((e) => !hasEnded(e));
---

<BaseLayout title={f.name} description={`${f.name}, ${f.title} of ${department.field} at ${siteConfig.name}.`} page={pageMeta.faculty(f)}>
  <Breadcrumb items={[{ label: "Faculty", href: "/about/faculty/" }, { label: f.name, href: path }]} />
  <div class="detail">
    <article>
      <h1>{f.name}</h1>
      <p class="lede">{f.title} of {department.field}{f.role && `, ${f.role.toLowerCase()}`}</p>

      <h2>About</h2>
      <p>{f.bio}</p>

      <h2>Research interests</h2>
      <ul>{f.research_interests.map((r) => <li>{r}</li>)}</ul>

      <h2>Courses</h2>
      {
        courses.length ? (
          <ul>{courses.map((c) => <li><a href={pagePath("courses", c.id)}>{c.code}: {c.title}</a></li>)}</ul>
        ) : (
          <p>Not teaching any listed courses this year.</p>
        )
      }

      {
        upcoming.length > 0 && (
          <section aria-labelledby="events-title">
            <h2 id="events-title">Upcoming events</h2>
            <EventList events={upcoming} upcomingOnly />
          </section>
        )
      }
    </article>

    <AtAGlance
      heading="Contact"
      facts={[
        ["Title", f.title],
        ...(f.role ? [["Role", f.role] as [string, string]] : []),
        ["Department", { text: department.field, href: subjectPath(department.id) }],
        ["Office", f.office],
        ["Email", { text: f.email, href: `mailto:${f.email}` }],
      ]}
    />
  </div>
</BaseLayout>

<script>
  import "../../../../scripts/past-events.ts";
</script>
