---
// All events for the academic year. Upcoming events show by default; the
// "When" filter brings back past ones.
import { getCollection } from "astro:content";
import siteConfig from "../../../../site.config.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AskAiMenu from "../../../components/AskAiMenu.astro";
import EventList from "../../../components/EventList.astro";
import { AUDIENCES, CAMPUSES, EVENT_CATEGORIES } from "../../../lib/vocab.ts";

// Collections come back in no particular order, so sort by start time
const events = (await getCollection("events")).map((e) => e.data).sort((a, b) => Date.parse(a.start) - Date.parse(b.start));

const filters = [
  { name: "category", label: "Category", any: "Any category", options: EVENT_CATEGORIES },
  { name: "audience", label: "For", any: "Anyone", options: AUDIENCES },
  { name: "campus", label: "Campus", any: "Any campus", options: CAMPUSES },
];

const prompt = `Help me find events at ${siteConfig.name} using {origin}/about/events/. If I haven't said what I'm looking for, ask me one short question. Then recommend specific upcoming events with dates and links.`;
---

<BaseLayout title="Events" description={`Tours, lectures, performances, workshops, and more at ${siteConfig.name}.`}>
  <div class="page-intro">
    <h1>Events</h1>
    <p>Campus tours, public lectures, performances, workshops, and more. Everything is free unless noted.</p>
    <AskAiMenu prompt={prompt} label="Explore events with AI" />
  </div>

  <form class="finder" data-filter-form="event-list" data-noun="event" role="search" aria-label="Filter events">
    <div class="field search">
      <label for="q">Search events</label>
      <input id="q" name="q" type="search" placeholder="For example, tour, concert, or financial aid" />
    </div>
    <div class="field">
      <label for="when">When</label>
      <select id="when" name="when">
        <option value="upcoming" selected>Upcoming</option>
        <option value="past">Past</option>
        <option value="">All events</option>
      </select>
    </div>
    {
      filters.map((f) => (
        <div class="field">
          <label for={f.name}>{f.label}</label>
          <select id={f.name} name={f.name}>
            <option value="">{f.any}</option>
            {f.options.map((o) => <option value={o}>{o}</option>)}
          </select>
        </div>
      ))
    }
  </form>

  <p id="event-list-count" class="results-count" aria-live="polite">{events.length} events</p>
  <EventList events={events} id="event-list" headingLevel={2} />
</BaseLayout>

<script>
  // past-events marks each event as past or upcoming and re-runs the filter,
  // so the default "Upcoming" works whichever script runs first.
  import "../../../scripts/filter-list.ts";
  import "../../../scripts/past-events.ts";
</script>
