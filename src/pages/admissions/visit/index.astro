---
import { getPage } from "../../../lib/pages.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import EventList from "../../../components/EventList.astro";
import { events, hasEnded } from "../../../lib/catalog.ts";

const page = await getPage("admissions/visit");
const { Content } = page;
const path = "/admissions/visit/";
const visits = events.filter((e) => e.category === "Admissions" && !hasEnded(e));
---

<BaseLayout title={page.title} description={page.description}>
  <Breadcrumb items={[{ label: "Admissions", href: "/admissions/" }, { label: page.title, href: path }]} />
  <div class="detail">
    <article>
      <h1>{page.title}</h1>
      <p class="lede">{page.description}</p>
      <p><a class="button" href="/admissions/visit/schedule/">Schedule a visit</a></p>
      <Content />
    </article>
    <aside aria-labelledby="visits-title">
      <h2 id="visits-title">Upcoming tours and sessions</h2>
      <EventList events={visits} upcomingOnly limit={6} />
      <p><a href="/about/events/">All events</a></p>
    </aside>
  </div>
</BaseLayout>

<script>
  import "../../../scripts/past-events.ts";
</script>

<style>
  aside h2 { font-size: var(--step-1); }
</style>
