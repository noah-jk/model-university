---
import { getEntry, render } from "astro:content";
import siteConfig from "../../../../site.config.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AskAiMenu from "../../../components/AskAiMenu.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import EventList from "../../../components/EventList.astro";
import { events, hasEnded } from "../../../lib/catalog.ts";

const entry = (await getEntry("pages", "admissions/visit"))!;
const { Content } = await render(entry);
const path = "/admissions/visit/";
const visits = events.filter((e) => e.category === "Admissions" && !hasEnded(e));
const prompt = `Read {origin}${path} and help me plan a visit to ${siteConfig.name}. Suggest upcoming tours or events that fit my schedule, with links.`;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Breadcrumb items={[{ label: "Admissions", href: "/admissions/" }, { label: entry.data.title, href: path }]} />
  <div class="detail">
    <article>
      <h1>{entry.data.title}</h1>
      <p class="lede">{entry.data.description}</p>
      <AskAiMenu prompt={prompt} label="Plan a visit with AI" />
      <Content />
    </article>
    <aside aria-labelledby="visits-title">
      <h2 id="visits-title">Upcoming tours and sessions</h2>
      <EventList events={visits} upcomingOnly limit={6} />
      <p><a href="/events/">All events</a></p>
    </aside>
  </div>
</BaseLayout>

<script>
  import "../../../scripts/past-events.ts";
</script>

<style>
  aside h2 { font-size: var(--step-1); }
</style>
