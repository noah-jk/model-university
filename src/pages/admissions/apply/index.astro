---
import { getEntry, render } from "astro:content";
import siteConfig from "../../../../site.config.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import AskAiMenu from "../../../components/AskAiMenu.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";

const entry = (await getEntry("pages", "admissions/apply"))!;
const { Content } = await render(entry);
const path = "/admissions/apply/";
const prompt = `Read {origin}${path} and help me apply to ${siteConfig.name}. If I haven't said whether I'm a first-year, transfer, or graduate applicant, ask me, then give me my steps and deadlines with links.`;
---

<BaseLayout title={entry.data.title} description={entry.data.description}>
  <Breadcrumb items={[{ label: "Admissions", href: "/admissions/" }, { label: entry.data.title, href: path }]} />
  <article class="prose">
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.description}</p>
    <AskAiMenu prompt={prompt} label="Ask AI about applying" />
    <Content />
  </article>
</BaseLayout>
