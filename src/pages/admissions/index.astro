---
import siteConfig from "../../../site.config.ts";
import { getPage } from "../../lib/pages.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { JOURNEY } from "../../lib/personalization-settings.ts";
import PathHandoff from "../../components/workbench/PathHandoff.astro";
import AskAiMenu from "../../components/AskAiMenu.astro";
import PageIntro from "../../components/PageIntro.astro";
import introImage from "../../assets/images/students-campus-2.jpg";
import EventList from "../../components/EventList.astro";
import { events, hasEnded } from "../../lib/catalog.ts";

const page = await getPage("admissions");
const { Content } = page;
const upcoming = events.filter((e) => e.category === "Admissions" && !hasEnded(e));

// Request information and visiting are here rather than at the top, which keeps
// one action (Apply) above the fold (#27)
const paths = [
  { href: "/admissions/apply/", title: "How to apply", text: "Steps and deadlines for first-year, transfer, and graduate students." },
  { href: JOURNEY.find((j) => j.step === "requestInfo")!.href, title: "Request information", text: "Tell us what interests you, and an admissions counselor will send details and next steps." },
  { href: "/admissions/tuition-and-aid/", title: "Tuition and aid", text: "What it costs, and the grants, scholarships, and work-study that help." },
  { href: "/admissions/visit/", title: "Visit campus", text: "Tours, open houses, and online information sessions." },
  { href: "/academics/programs/", title: "Find a program", text: "Search every degree, minor, and certificate." },
];
// Admissions pages for particular students, with their steps and dates
const audiences = [
  { href: "/admissions/transfer/", title: "Transfer students", text: "Bringing credits from another college, or coming back to finish." },
  { href: "/admissions/international/", title: "International students", text: "English scores, financial documents, your I-20, and your visa." },
  { href: "/admissions/graduate/", title: "Graduate students", text: "Master's, doctoral, and certificate programs, and funding." },
];
const deadlines = [
  ["Fall", "March 1"],
  ["Winter", "October 15"],
  ["Spring", "January 15"],
];

const prompt = `I'm thinking about applying to ${siteConfig.name}. Use {origin}/admissions/ and {origin}/llms.txt to help me. If I haven't said what I want to study, ask me one short question, then tell me how to apply, what it will cost, and the deadlines that matter for me, with links.`;
---

<BaseLayout title={page.title} description={page.description}>
  <PageIntro image={introImage}>
    <h1>{page.title}</h1>
    <p class="lede">{page.description}</p>
    <div class="intro-actions">
      <a class="button" href={JOURNEY.find((j) => j.step === "apply")!.href} data-journey-apply>Apply</a>
      <AskAiMenu prompt={prompt} label="Ask AI about applying" quiet />
    </div>
    {siteConfig.features.workbench && <PathHandoff id="admissions" slot="side" />}
  </PageIntro>

  <div class="detail">
    <article>
      <Content />

      <ul class="paths">
        {
          paths.map((p) => (
            <li>
              <h2><a href={p.href}>{p.title}</a></h2>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ul>

      <section aria-labelledby="audiences-title">
        <h2 id="audiences-title">Steps for your situation</h2>
        <ul class="paths audiences">
          {
            audiences.map((a) => (
              <li>
                <h3><a href={a.href}>{a.title}</a></h3>
                <p>{a.text}</p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="events-title">
        <h2 id="events-title">Upcoming admissions events</h2>
        <EventList events={upcoming} upcomingOnly limit={4} />
        <p><a href="/about/events/">All events</a></p>
      </section>
    </article>

    <aside class="panel deadlines" aria-labelledby="deadlines-title">
      <h2 id="deadlines-title">First-year deadlines</h2>
      <table>
        <caption class="visually-hidden">Application deadlines by start term</caption>
        <thead><tr><th scope="col">Start term</th><th scope="col">Apply by</th></tr></thead>
        <tbody>{deadlines.map(([term, date]) => <tr><th scope="row">{term}</th><td>{date}</td></tr>)}</tbody>
      </table>
      <p>Graduate deadlines vary by program. Check the program page.</p>
    </aside>
  </div>
</BaseLayout>

<script>
  import "../../scripts/past-events.ts";
</script>

<style>
  .intro-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem 1rem; margin-top: 1.25rem; }
  /* The Your Path panel beside the intro (PageIntro's side slot): no extra
     margin, and its picker stacks */
  :global(.page-intro .side .handoff) { margin: 0; }
  :global(.page-intro .side .handoff-pick) { flex-direction: column; align-items: stretch; }
  :global(.page-intro .side .handoff-pick select) { width: 100%; }
  .paths { list-style: none; padding: 0; margin: 2rem 0; display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
  .paths li { border-top: 3px solid var(--fir); padding-top: 0.75rem; }
  .detail article .paths h2, .detail article .paths h3 { font-size: var(--step-1); margin: 0 0 0.25rem; }
  .audiences { margin-top: 1rem; }
  .paths p { margin: 0; color: var(--muted); }
  .deadlines { align-self: start; }
  .deadlines h2 { font-size: var(--step-1); }
  .deadlines p { font-size: var(--step--1); color: var(--muted); margin: 1rem 0 0; }
</style>
