---
import siteConfig from "../../../../site.config.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { getPage } from "../../../lib/pages.ts";
import { programs } from "../../../lib/catalog.ts";
import { JOURNEY, MAX_VIEWS } from "../../../lib/personalization-settings.ts";
import { pagePath, SECTION_PATH } from "../../../lib/urls.ts";

const page = await getPage("lab/personalization");
const { Content } = page;
const path = "/lab/personalization/";
const enabled = siteConfig.features.personalization;
// Two nursing programs to try it with
const nursing = programs.filter((p) => p.department === "nursing").slice(0, 2);
const step = (name: string) => JOURNEY.find((j) => j.step === name)!;
---

<BaseLayout title={page.title} description={page.description}>
  <Breadcrumb items={[{ label: "Lab", href: "/lab/" }, { label: page.title, href: path }]} />
  <article class="prose">
    <h1>{page.title}</h1>
    <p class="lede">{page.description}</p>

    {
      enabled ? (
        <section class="panel try" aria-labelledby="try-title">
          <h2 id="try-title">Try it</h2>
          <ol>
            <li>
              Explore a couple of programs, like{" "}
              {nursing.map((p, i) => (
                <>
                  {i > 0 && " and "}
                  <a href={pagePath("programs", p.id)}>{p.name}</a>
                </>
              ))}
              . Open <strong>Recents</strong> in the header: your next step is requesting information.
            </li>
            <li>
              Fill in the <a href={step("requestInfo").href}>request information</a> form, then the <a href={step("visit").href}>visit</a> form. Each one moves
              your journey forward, and the visit form fills in your name and email for you.
            </li>
            <li>
              Click any <strong>Apply</strong> button to finish the journey. The <a href={`${SECTION_PATH.programs}/`}>program list</a> also puts your
              most-viewed department first.
            </li>
            <li>
              Open the panel to see your journey, interest profile, form answers, and visit log.{" "}
              <button type="button" class="link-button needs-js" data-under-the-hood-toggle aria-expanded="false">Open Under the hood</button>
              <noscript>(The panel needs JavaScript.)</noscript>
            </li>
          </ol>
          <p class="hint">You can also add <code>?demo</code> to any address to open the panel there, for example <a href="/?demo">the home page with the panel open</a>.</p>
        </section>
      ) : (
        <p class="panel"><strong>This experiment is switched off on this site.</strong> Set <code>personalization: true</code> in <code>site.config.ts</code> to turn it on.</p>
      )
    }

    <Content />
    <p class="hint">The log keeps at most {MAX_VIEWS} page views. The code is in <code>src/scripts/personalize.ts</code>, <code>src/components/Recents.astro</code>, <code>src/components/forms/</code>, and <code>src/components/UnderTheHood.astro</code>.</p>
  </article>
</BaseLayout>

<style>
  .try { margin-block: 1.5rem 2rem; border-left: 6px solid var(--fir); }
  .try h2 { margin-top: 0; }
  .try ol { padding-left: 1.25rem; }
  .try li { margin-bottom: 0.5rem; }
  .hint { font-size: var(--step--1); color: var(--muted); }
</style>
