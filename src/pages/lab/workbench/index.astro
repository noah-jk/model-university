---
import siteConfig from "../../../../site.config.ts";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumb from "../../../components/Breadcrumb.astro";
import { getPage } from "../../../lib/pages.ts";
import { MAX_ITEMS, MAX_NOTE, STORAGE_KEY, WORKBENCH_LABEL, WORKBENCH_PATH } from "../../../lib/workbench/types.ts";
import { pagePath } from "../../../lib/urls.ts";

const page = await getPage("lab/workbench");
const { Content } = page;
const path = "/lab/workbench/";
const enabled = siteConfig.features.workbench;
const weightNote = siteConfig.features.personalization ? "In the personalization profile, each saved item counts as much as three page views." : "";
---

<BaseLayout title={page.title} description={page.description}>
  <Breadcrumb items={[{ label: "Lab", href: "/lab/" }, { label: page.title, href: path }]} />
  <article class="prose">
    <h1>{page.title}</h1>
    <p class="lede">{page.description}</p>

    {
      enabled ? (
        <section class="panel try" aria-labelledby="try-title">
          <h2 id="try-title">Try it</h2>
          <ol>
            <li>
              Open <a href={WORKBENCH_PATH}>{WORKBENCH_LABEL}</a> and choose <strong>Transfer</strong>. The level becomes Undergraduate, and your steps, offices, and
              timeline appear, with nothing saved.
            </li>
            <li>Check off a step, then change the start term. Every date changes, and the step stays done.</li>
            <li>
              Use <strong>Reset student type to suggested</strong>. Then, in the same tab, open <a href="/admissions/transfer/">Transfer admissions</a> and the{" "}
              <a href={pagePath("services", "transfer-center")}>Transfer Center</a>, and come back: {WORKBENCH_LABEL} suggests Transfer and Undergraduate, and says why.
            </li>
            <li>Dismiss an office, then use <strong>Show dismissed items</strong> to bring it back.</li>
          </ol>
        </section>
      ) : (
        <p class="panel">
          <strong>This experiment is switched off on this site.</strong> Set <code>workbench: true</code> in <code>site.config.ts</code> to turn it on.
        </p>
      )
    }

    <Content />
    <p class="hint">
      It holds up to {MAX_ITEMS} items, with notes of up to {MAX_NOTE.toLocaleString("en-US")} characters, under the localStorage key <code>{STORAGE_KEY}</code>. {weightNote}
      The rules are in <code>content/enrollment/</code>. The code is in <code>src/lib/workbench/</code> (the data model, store, profile, plan, and views, with no
      page code), <code>src/scripts/workbench/</code>, and <code>src/features/workbench/</code>.
    </p>
  </article>
</BaseLayout>

<style>
  .try { margin-block: 1.5rem 2rem; border-left: 6px solid var(--fir); }
  .try h2 { margin-top: 0; }
  .try ol { padding-left: 1.25rem; }
  .try li { margin-bottom: 0.5rem; }
  .hint { font-size: var(--step--1); color: var(--muted); }
</style>
