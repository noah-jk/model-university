---
// /your-path/: Your Path, the plan the site builds for a student (steps,
// dates, and offices for their start term) plus everything they've saved,
// with notes and a program comparison. Built only when the
// workbench is switched on. The page is a shell: src/scripts/workbench/page.ts
// fills it from localStorage, /data/enrollment.json, and
// /data/workbench-index.json, so it always shows live content.
import siteConfig from "../../../site.config.ts";
import BaseLayout from "../../layouts/BaseLayout.astro";
import NextStep from "../../components/NextStep.astro";
import { WORKBENCH_LABEL } from "../../lib/workbench/types.ts";

const personalization = siteConfig.features.personalization;
const title = `Your path to ${siteConfig.shortName}`;
// Your plan (steps and dates in one list, #30), what's saved, and Compare
const tabs = [
  { id: "plan", label: "Your plan" },
  { id: "items", label: "Saved" },
  { id: "compare", label: "Compare" },
];
---

<BaseLayout title={title} description={`Your steps, deadlines, and the offices that can help, for your start term at ${siteConfig.name}, plus the programs, courses, and events you save.`}>
  <div class="page-intro">
    <h1>{title}</h1>
    <p class="lede">
      Answer two questions and we'll build your plan: every step, deadline, and office you need, for your start term. Anything you save as you browse
      shows up here too.
    </p>
    <p class="where">Saved only in this browser, never sent anywhere. <a class="note-link" href="/lab/workbench/">How {WORKBENCH_LABEL} works</a></p>
  </div>

  <noscript><p class="panel">{WORKBENCH_LABEL} needs JavaScript, because it's kept in your browser.</p></noscript>

  <div class="workbench needs-js" data-workbench>
    <form class="profile-bar" data-profile>
      <fieldset>
        <legend>Your plan</legend>
        <div class="bar">
          <span class="pick">
            <span class="pick-label">
              <label for="pf-type">Student type</label>
              <span class="tag" data-tag="studentType" hidden>Suggested</span>
              <button type="button" class="note-link why-toggle" data-why="studentType" aria-expanded="false" aria-controls="why-panel" hidden>Why?<span class="visually-hidden" data-why-name="studentType"> student type</span></button>
            </span>
            <select id="pf-type" data-field="studentType"></select>
          </span>
          <span class="pick">
            <span class="pick-label">
              <label for="pf-level">Level</label>
              <span class="tag" data-tag="level" hidden>Suggested</span>
              <button type="button" class="note-link why-toggle" data-why="level" aria-expanded="false" aria-controls="why-panel" hidden>Why?<span class="visually-hidden" data-why-name="level"> level</span></button>
            </span>
            <select id="pf-level" data-field="level"></select>
          </span>
          <span class="pick">
            <span class="pick-label">
              <label for="pf-term">Start term</label>
              <span class="tag" data-tag="startTerm" hidden>Suggested</span>
              <button type="button" class="note-link why-toggle" data-why="startTerm" aria-expanded="false" aria-controls="why-panel" hidden>Why?<span class="visually-hidden" data-why-name="startTerm"> start term</span></button>
            </span>
            <select id="pf-term" data-field="startTerm"></select>
          </span>
        </div>
        <div class="why-panel" id="why-panel" data-why-panel hidden></div>
        <div class="profile-notes" data-profile-notes></div>
      </fieldset>
    </form>

    <div class="tabs" role="tablist" aria-label={`${WORKBENCH_LABEL} views`}>
      {
        tabs.map((tab, i) => (
          <button type="button" role="tab" id={`tab-${tab.id}`} aria-controls={`panel-${tab.id}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>
            {tab.label}
            <span class="tab-count" data-tab-count={tab.id} />
          </button>
        ))
      }
    </div>

    {
      tabs.map((tab, i) => (
        <section role="tabpanel" id={`panel-${tab.id}`} aria-labelledby={`tab-${tab.id}`} tabindex="0" hidden={i !== 0} data-panel={tab.id}>
          <p class="loading">Loading…</p>
        </section>
      ))
    }

    <div class="dismissed" data-dismissed hidden></div>

    {
      personalization && (
        <section class="wb-next" aria-label="Your next step" data-wb-next hidden>
          <NextStep headingLevel="h2" wide />
        </section>
      )
    }
  </div>

  <div class="undo-bar" data-undo hidden>
    <p data-undo-text></p>
    <button type="button" class="button" data-undo-button>Undo</button>
  </div>
</BaseLayout>

<script>
  import "../../scripts/workbench/page.ts";
</script>

<style>
  .page-intro { max-width: var(--measure); }
  .where { color: var(--muted); }
  .hint { margin: 0; font-size: var(--step--1); color: var(--muted); }

  /* Profile bar: a sentence with a select for each value */
  .profile-bar { margin: 1.5rem 0 2rem; }
  .profile-bar fieldset { margin: 0; padding: 0; border: 0; min-width: 0; }
  .profile-bar legend { padding: 0; margin-bottom: 0.5rem; font: 600 var(--step--1) / 1.2 var(--sans); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  /* One integrated bar: a segment for each value, split by thin lines. The
     selects stay native, styled to fill their segment. */
  .bar { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); background: var(--paper); border: 1.5px solid var(--fir); border-radius: var(--radius-s); box-shadow: 0 1px 2px rgb(0 0 0 / 0.06); }
  .pick { position: relative; display: grid; gap: 0.1rem; padding: 0.55rem 2.5rem 0.5rem 1rem; min-width: 0; }
  .pick + .pick { border-left: 1px solid var(--line); }
  .pick:first-child { border-radius: var(--radius-s) 0 0 var(--radius-s); }
  .pick:last-child { border-radius: 0 var(--radius-s) var(--radius-s) 0; }
  /* The select has no ring of its own; its segment shows focus */
  .pick:focus-within { outline: 3px solid var(--focus); outline-offset: -3px; }
  .pick:hover { background: var(--fog); }
  /* The label, with "Suggested" beside it when the value was suggested */
  .pick-label { display: flex; align-items: center; gap: 0.4rem; min-height: 1.4rem; }
  .pick label { font: 600 var(--step--1) / 1.2 var(--sans); color: var(--muted); }
  .pick select { appearance: none; width: 100%; min-height: 2rem; padding: 0; margin: 0; font: 600 var(--step-1) / 1.3 var(--sans); color: var(--basalt); background: transparent; border: 0; cursor: pointer; text-overflow: ellipsis; }
  .pick select:focus { outline: none; }
  /* The select's arrow, drawn so it matches the theme */
  .pick::after { content: ""; position: absolute; right: 1.1rem; bottom: 1.05rem; width: 0.5rem; height: 0.5rem; border: solid var(--fir); border-width: 0 2px 2px 0; transform: rotate(45deg); pointer-events: none; }
  .tag { padding: 0.05rem 0.45rem; border-radius: 999px; background: var(--lichen); color: var(--basalt); font: 700 0.75rem / 1.4 var(--sans); }
  @media (max-width: 40rem) {
    .bar { grid-template-columns: 1fr; }
    .pick + .pick { border-left: 0; border-top: 1px solid var(--line); }
    .pick:first-child { border-radius: var(--radius-s) var(--radius-s) 0 0; }
    .pick:last-child { border-radius: 0 0 var(--radius-s) var(--radius-s); }
  }
  .why-toggle { margin-left: auto; position: relative; z-index: 1; }
  /* The reason for one value, opened from its segment's Why? */
  .why-panel { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin-top: 0.5rem; font-size: var(--step--1); color: var(--muted); }
  .why-panel[hidden] { display: none; }
  .why-panel :global(p) { margin: 0; }
  .profile-notes { margin-top: 0.75rem; }
  .profile-notes :global(p) { margin: 0; }
  .profile-notes :global(.ask) { font-weight: 600; }

  /* Steps and offices */
  .progress { margin: 0 0 0.75rem; color: var(--muted); }
  .workbench :global(.path-list) { list-style: none; margin: 0; padding: 0; }
  .workbench :global(.path-list li) { max-width: none; position: relative; display: grid; gap: 0.3rem; padding: 0.9rem 1rem 1rem 3.25rem; border-bottom: 1px solid var(--line); }
  .workbench :global(.path-list li.step-row::before) { content: attr(data-n); position: absolute; left: 0.75rem; top: 0.95rem; width: 1.75rem; height: 1.75rem; border-radius: 999px; display: grid; place-items: center; font: 700 var(--step--1) / 1 var(--sans); background: var(--lichen); color: var(--basalt); }
  .workbench :global(.path-list li.is-next) { background: var(--paper); border: 2px solid var(--fir); border-radius: var(--radius-s); margin-block: 0.25rem; }
  .workbench :global(.path-list li.step-row.is-next::before) { background: var(--fir); color: var(--fog); }
  .workbench :global(.path-list .check) { display: flex; align-items: flex-start; gap: 0.6rem; }
  .workbench :global(.path-list .check input) { width: 1.25rem; height: 1.25rem; margin: 0.15rem 0 0; flex: none; accent-color: var(--fir); }
  .workbench :global(.path-list .check label) { font-weight: 600; }
  .workbench :global(.path-list li.is-done .check label) { color: var(--muted); }
  .workbench :global(.path-list p) { margin: 0; }
  .workbench :global(.path-list .status) { font-size: var(--step--1); font-weight: 600; }
  .workbench :global(.path-list .status .overdue) { color: var(--salmonberry); }
  .workbench :global(.path-list .status .next) { display: inline-block; padding: 0 0.45rem; margin-right: 0.35rem; border-radius: 999px; background: var(--fir); color: var(--fog); }
  .workbench :global(.path-list .links) { display: flex; flex-wrap: wrap; gap: 0.25rem 1.25rem; font-size: var(--step--1); }
  .workbench :global(.path-list .step-note) { font-size: var(--step--1); color: var(--muted); }
  .workbench :global(.offices) { list-style: none; margin: 0; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(15rem, 1fr)); }
  .workbench :global(.offices li) { max-width: none; display: grid; gap: 0.35rem; align-content: start; justify-items: start; padding: 0.9rem 1rem; background: var(--paper); border: 1px solid var(--line); border-top: 3px solid var(--fir); border-radius: var(--radius-s); }
  .workbench :global(.offices a) { font-weight: 600; }
  .workbench :global(.offices p) { margin: 0; font-size: var(--step--1); color: var(--muted); }
  .workbench :global(.for-you) { font: 700 0.75rem / 1.4 var(--sans); text-transform: uppercase; letter-spacing: 0.06em; color: var(--muted); }
  .workbench :global(.for-you details) { display: inline; text-transform: none; letter-spacing: 0; }
  .workbench :global(.for-you details > p) { text-transform: none; letter-spacing: 0; font-weight: 400; }
  .dismissed { margin-top: 2rem; font-size: var(--step--1); }
  .dismissed :global(ul) { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .dismissed :global(li) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1rem; padding-block: 0.4rem; border-bottom: 1px solid var(--line); }
  .wb-next { margin-top: 3rem; }

  /* Tabs */
  .tabs { display: flex; gap: 0.25rem; border-bottom: 2px solid var(--line); margin-bottom: 1.5rem; overflow-x: auto; }
  [role="tab"] { display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0.5rem 1rem; margin-bottom: -2px; font: 600 var(--step-0) var(--sans); color: var(--muted); background: none; border: 0; border-bottom: 3px solid transparent; cursor: pointer; white-space: nowrap; }
  [role="tab"]:hover { color: var(--basalt); }
  [role="tab"][aria-selected="true"] { color: var(--basalt); border-bottom-color: var(--fir); }
  [role="tab"]:focus-visible { outline-offset: -3px; }
  .tab-count:not(:empty) { min-width: 1.4rem; padding: 0.05rem 0.4rem; border-radius: 999px; background: var(--lichen); color: var(--basalt); font-size: var(--step--1); text-align: center; }
  [role="tabpanel"]:focus-visible { outline-offset: 6px; }
  .loading { color: var(--muted); }

  /* Items (rendered by page.ts) */
  .workbench :global(.wb-group) { margin-bottom: 2rem; }
  .workbench :global(.wb-group > h2) { font-size: var(--step-2); margin-bottom: 0.5rem; }
  .workbench :global(h2:focus), .workbench :global(h3:focus) { outline: none; }
  .workbench :global(h2:focus-visible) { outline: 3px solid var(--focus); }
  .workbench :global(.wb-items) { list-style: none; margin: 0; padding: 0; }
  .workbench :global(.wb-item) { max-width: none; display: grid; gap: 0.5rem; padding-block: 1rem; border-bottom: 1px solid var(--line); }
  .workbench :global(.wb-item h3) { font: 600 var(--step-0) / 1.35 var(--sans); margin: 0; }
  .workbench :global(.wb-item .facts) { margin: 0; }
  .workbench :global(.wb-item .facts span) { display: block; }
  .workbench :global(.wb-item .facts span + span::before) { content: none; }
  .workbench :global(.wb-flag) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 0.75rem; margin: 0; padding: 0.5rem 0.75rem; background: var(--lichen); border-radius: var(--radius-s); font-size: var(--step--1); }
  .workbench :global(.wb-note) { display: grid; gap: 0.3rem; max-width: 40rem; }
  .workbench :global(.wb-note label) { font-size: var(--step--1); font-weight: 600; }
  .workbench :global(textarea) { width: 100%; min-height: 4.5rem; padding: 0.5rem 0.65rem; font: inherit; color: var(--basalt); background: var(--paper); border: 1.5px solid var(--muted); border-radius: var(--radius-s); resize: vertical; }
  .workbench :global(.wb-actions) { display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .workbench :global(.wb-actions button), .workbench :global(.wb-flag button), .workbench :global(.small-button), .workbench :global(.offices button), .dismissed :global(button) {
    min-height: 36px; padding: 0.3rem 0.8rem; font: 600 var(--step--1) / 1 var(--sans); color: var(--fir); background: transparent; border: 1.5px solid var(--line); border-radius: 999px; cursor: pointer;
  }
  .workbench :global(.wb-actions button:hover), .workbench :global(.small-button:hover), .workbench :global(.offices button:hover), .dismissed :global(button:hover) { border-color: var(--fir); }
  /* More actions: the list opens beside its button and wraps on small screens */
  .workbench :global(.more) { display: flex; flex-wrap: wrap; align-items: center; gap: 0.4rem; }
  .workbench :global(.more-toggle::after) { content: ""; display: inline-block; width: 0.4em; height: 0.4em; margin-left: 0.45em; border: solid currentColor; border-width: 0 2px 2px 0; transform: translateY(-0.15em) rotate(45deg); }
  .workbench :global(.more-toggle[aria-expanded="true"]::after) { transform: translateY(0.1em) rotate(-135deg); }
  .workbench :global(.more-list) { display: flex; flex-wrap: wrap; gap: 0.4rem; list-style: none; margin: 0; padding: 0; }
  .workbench :global(.more-list[hidden]) { display: none; }
  .workbench :global(.more-list li) { margin: 0; }
  .workbench :global(button[aria-disabled="true"]) { color: var(--muted); border-style: dashed; cursor: not-allowed; }
  .workbench :global(.wb-missing) { color: var(--muted); }
  .workbench :global(.add-note) { display: grid; gap: 0.4rem; max-width: 40rem; margin-top: 1rem; }
  .workbench :global(.add-note label) { font-weight: 600; }
  .workbench :global(.add-note .row) { display: flex; gap: 0.5rem; }
  .workbench :global(.empty) { max-width: var(--measure); }
  .workbench :global(.pickup) { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .workbench :global(.pickup li) { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-block: 0.6rem; border-bottom: 1px solid var(--line); max-width: 40rem; }

  /* Compare */
  /* Compare's search: a combobox with a list of matching programs */
  .workbench :global(.compare-add) { max-width: 36rem; margin-bottom: 1.5rem; }
  .workbench :global(.compare-add label) { display: block; font-weight: 600; }
  .workbench :global(.compare-add .hint) { margin: 0.15rem 0 0.4rem; }
  .workbench :global(.combo) { position: relative; }
  .workbench :global(.combo input) { width: 100%; min-height: 44px; padding: 0.5rem 0.75rem; font: inherit; color: var(--basalt); background: var(--paper); border: 1.5px solid var(--fir); border-radius: var(--radius-s); }
  .workbench :global(.combo [role="listbox"]) { position: absolute; z-index: 5; left: 0; right: 0; top: calc(100% + 0.25rem); max-height: 18rem; overflow-y: auto; margin: 0; padding: 0.25rem; list-style: none; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-s); box-shadow: 0 6px 18px rgb(0 0 0 / 0.15); }
  .workbench :global(.combo [role="listbox"][hidden]) { display: none; }
  .workbench :global(.combo [role="option"]) { display: flex; justify-content: space-between; gap: 1rem; max-width: none; margin: 0; padding: 0.5rem 0.65rem; border-radius: var(--radius-s); cursor: pointer; }
  .workbench :global(.combo [role="option"][aria-selected="true"]), .workbench :global(.combo [role="option"]:hover) { background: var(--lichen); outline: 2px solid var(--fir); outline-offset: -2px; }
  .workbench :global(.option-meta) { font-size: var(--step--1); color: var(--muted); white-space: nowrap; }
  /* What's compared, other saved programs, and recent ones, as chips */
  .workbench :global(.chip-groups) { display: grid; gap: 0.75rem; margin-bottom: 1.25rem; }
  .workbench :global(.chip-group h3) { margin: 0 0 0.35rem; font: 600 var(--step--1) / 1.2 var(--sans); color: var(--muted); }
  .workbench :global(.chips) { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0; padding: 0; list-style: none; }
  .workbench :global(.chips li) { display: inline-flex; align-items: center; gap: 0.5rem; max-width: none; margin: 0; padding: 0.2rem 0.25rem 0.2rem 0.75rem; background: var(--paper); border: 1px solid var(--line); border-radius: 999px; font-size: var(--step--1); }
  .workbench :global(.chips button) { min-height: 32px; padding: 0.2rem 0.7rem; font: 600 var(--step--1) / 1 var(--sans); color: var(--fir); background: transparent; border: 1.5px solid var(--line); border-radius: 999px; cursor: pointer; }
  .workbench :global(.chips button:hover) { border-color: var(--fir); }
  .workbench :global(.compare-full) { font-size: var(--step--1); color: var(--muted); }
  .workbench :global(.pickup-section) { margin-top: 1.5rem; }
  .workbench :global(.pickup-section h2) { font-size: var(--step-1); margin: 0; }
  .workbench :global(.compare-wrap) { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--radius-s); background: var(--paper); }
  .workbench :global(.compare-wrap:focus-visible) { outline-offset: 2px; }
  .workbench :global(.compare) { min-width: 30rem; }
  .workbench :global(.compare caption) { text-align: left; padding: 0.75rem 1rem; font-weight: 600; }
  .workbench :global(.compare th), .workbench :global(.compare td) { padding: 0.6rem 1rem; }
  .workbench :global(.compare thead th) { vertical-align: bottom; }
  /* Row labels stay in view while the programs scroll sideways */
  .workbench :global(.compare tbody th), .workbench :global(.compare thead td) { position: sticky; left: 0; z-index: 1; background: var(--paper); min-width: 8.5rem; max-width: 12rem; }
  .workbench :global(.compare tbody th) { color: var(--muted); font-weight: 600; }
  .workbench :global(.compare th[scope="col"]) { min-width: 9.5rem; }
  .workbench :global(.not-offered) { color: var(--salmonberry); font-weight: 600; }
  .workbench :global(.scroll-hint) { font-size: var(--step--1); color: var(--muted); }
  @media (min-width: 60rem) { .workbench :global(.scroll-hint) { display: none; } }

  /* Your plan: the list, with offices beside it on wide screens */
  .workbench :global(.plan-layout) { display: grid; gap: 2rem; }
  @media (min-width: 64rem) { .workbench :global(.plan-layout) { grid-template-columns: minmax(0, 1fr) 19rem; align-items: start; } }
  .workbench :global(.plan-for) { margin: 0 0 0.75rem; color: var(--muted); }
  .workbench :global(.plan-offices h2) { font-size: var(--step-1); margin: 0 0 0.75rem; }
  .workbench :global(.plan-offices .offices) { grid-template-columns: 1fr; }
  .workbench :global(.folded) { margin-bottom: 0.75rem; }
  .workbench :global(.folded .path-list) { margin-top: 0.5rem; }
  /* Steps for admitted students, folded below the rest until they're reached */
  .workbench :global(.admitted) { margin-top: 1rem; }
  .workbench :global(.admitted > summary) { font-size: var(--step-0); }
  .workbench :global(.admitted .path-list) { margin-top: 0.5rem; }
  /* Just after applying */
  .workbench :global(.applied) { margin-bottom: 0.75rem; padding: 0.85rem 1rem; border: 1px solid var(--line); border-left: 6px solid var(--fir); border-radius: var(--radius-s); background: var(--paper); }
  .workbench :global(.applied p) { margin: 0; max-width: var(--measure); }
  .workbench :global(.applied .applied-title) { margin-bottom: 0.25rem; font-family: var(--serif); font-size: var(--step-1); font-weight: 700; }
  .workbench :global(.applied-icon) { display: inline-grid; place-items: center; width: 1.6rem; height: 1.6rem; margin-right: 0.35rem; border-radius: 999px; background: var(--fir); color: var(--fog); font: 700 var(--step--1) / 1 var(--sans); vertical-align: 0.15em; }
  /* A date that isn't a step: lighter, with a small marker instead of a number */
  .workbench :global(.path-list li.date-row) { gap: 0.2rem; padding-block: 0.7rem; }
  .workbench :global(.path-list li.date-row::before) { content: ""; position: absolute; left: 1.35rem; top: 1.05rem; width: 0.6rem; height: 0.6rem; border-radius: 999px; border: 2px solid var(--fir); }
  .workbench :global(.path-list .when) { font-size: var(--step--1); font-weight: 600; }
  .workbench :global(.path-list .date-title) { font-weight: 600; }
  .workbench :global(.path-list .kind) { font-size: var(--step--1); color: var(--muted); }
  .workbench :global(.path-list .row-actions) { display: flex; flex-wrap: wrap; gap: 0.4rem; margin-top: 0.2rem; }
  .workbench :global(.path-list .past), .workbench :global(.path-list .past a) { color: var(--muted); }
  .workbench :global(.badge) { display: inline-block; margin-left: 0.5rem; padding: 0.05rem 0.5rem; border-radius: 999px; font: 700 0.75rem / 1.4 var(--sans); vertical-align: 0.1em; }
  .workbench :global(.badge.passed), .workbench :global(.badge.done) { background: var(--lichen); color: var(--basalt); }

  /* Undo, after removing an item */
  .undo-bar { position: fixed; z-index: 40; left: 50%; bottom: 1.25rem; transform: translateX(-50%); display: flex; align-items: center; gap: 1rem; max-width: calc(100% - 2rem); padding: 0.6rem 0.75rem 0.6rem 1.1rem; background: var(--fir-deep); color: var(--on-dark); border-radius: 999px; box-shadow: 0 6px 24px rgb(0 0 0 / 0.25); }
  .undo-bar p { margin: 0; }
