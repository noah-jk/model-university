---
// "For you": recently viewed pages and, optionally, recommended programs,
// built from this tab's session (see src/scripts/personalize.ts).
//
// Avoiding layout shift: the section is hidden by default. A small inline
// script runs while the page is still loading, before anything is drawn: it
// shows the section only if this tab has history and fills in "Recently
// viewed" right away. Recommendations need program data, so they get
// fixed-height rows that are filled in once the data arrives.
import siteConfig from "../../site.config.ts";
import { PROFILE_KEY, RECENT_COUNT, RECOMMEND_AFTER, TYPE_LABELS } from "../lib/personalization-settings.ts";

interface Props {
  recommend?: boolean;
}
const { recommend = false } = Astro.props;
const enabled = siteConfig.features.personalization;
---

{
  enabled && (
    <section class="for-you" aria-labelledby="for-you-title" hidden>
      <div class="intro">
        <h2 id="for-you-title">For you</h2>
        <p>Based on the pages you've viewed in this tab. <a href="/lab/personalization/">How this works</a></p>
      </div>
      <div class="modules">
        <div class="module">
          <h3>Recently viewed</h3>
          <ul class="rows recent-list" />
          <details>
            <summary>Why am I seeing this?</summary>
            <p>These are the last pages you opened in this tab. They're kept in your browser's session storage, never sent to us, and cleared when you close the tab.</p>
          </details>
        </div>
        {recommend && (
          <div class="module recommended">
            <h3>Recommended for you</h3>
            <div class="slot">
              <p class="message" />
              <ul class="rows recommended-list">
                <li />
                <li />
                <li />
              </ul>
            </div>
            <details>
              <summary>Why am I seeing this?</summary>
              <p class="why">Recommendations appear after you've viewed {RECOMMEND_AFTER} pages.</p>
            </details>
          </div>
        )}
      </div>
    </section>
    <script is:inline define:vars={{ key: PROFILE_KEY, recentCount: RECENT_COUNT, recommendAfter: RECOMMEND_AFTER, typeLabels: TYPE_LABELS }}>
      // Runs before first paint (see the note at the top of ForYou.astro).
      const section = document.currentScript.previousElementSibling;
      let views = [];
      try {
        views = JSON.parse(sessionStorage.getItem(key) || "null")?.views || [];
      } catch {}
      if (views.length) {
        section.hidden = false;
        // Last few distinct pages, newest first
        const seen = new Set();
        const recent = [];
        for (const view of views.slice().reverse()) {
          if (seen.has(view.type + view.id) || recent.length === recentCount) continue;
          seen.add(view.type + view.id);
          recent.push(view);
        }
        const list = section.querySelector(".recent-list");
        for (const view of recent) {
          const li = document.createElement("li");
          const a = document.createElement("a");
          a.href = view.url;
          a.textContent = view.name;
          const meta = document.createElement("span");
          meta.textContent = typeLabels[view.type];
          li.append(a, meta);
          list.append(li);
        }
        list.dataset.personalized = `Recently viewed: ${recent.length} ${recent.length === 1 ? "page" : "pages"} from this tab's history.`;
        // Too few views for recommendations: say so instead of reserving rows
        const recommended = section.querySelector(".recommended");
        if (recommended && views.length < recommendAfter) {
          const toGo = recommendAfter - views.length;
          recommended.querySelector(".message").textContent = `View ${toGo} more ${toGo === 1 ? "page" : "pages"} to see programs picked for you.`;
          recommended.querySelector(".recommended-list").hidden = true;
          recommended.dataset.personalized = `Recommended for you: waiting for ${recommendAfter} views (${views.length} so far).`;
        }
      }
    </script>
    <script>
      import "../scripts/for-you.ts";
    </script>
  )
}

<style>
  .for-you { margin-bottom: 3rem; padding: 1.25rem clamp(1rem, 3vw, 1.5rem); background: var(--paper); border: 1px solid var(--line); border-left: 6px solid var(--fir); border-radius: var(--radius-s); }
  .intro { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 1rem; margin-bottom: 0.75rem; }
  h2 { font-size: var(--step-2); margin: 0; }
  .intro p { margin: 0; font-size: var(--step--1); color: var(--muted); }
  .modules { display: grid; gap: 1.5rem 2.5rem; }
  @media (min-width: 48rem) { .modules:has(.recommended) { grid-template-columns: 1fr 1fr; } }
  h3 { font-family: var(--sans); font-weight: 600; font-size: var(--step-0); margin: 0 0 0.25rem; }
  .rows { list-style: none; padding: 0; margin: 0; }
  /* Every row is the same height whatever its text, so filling rows in later
     never moves anything. Long names are clamped to two lines. */
  .rows :global(li) { max-width: none; height: 4.5rem; padding-block: 0.45rem; border-bottom: 1px solid var(--line); overflow: hidden; }
  .rows :global(a) { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; line-height: 1.3; }
  .rows :global(span) { display: block; font-size: var(--step--1); color: var(--muted); line-height: 1.3; }
  .slot { height: 13.5rem; }
  .message { margin: 0.5rem 0 0; color: var(--muted); }
  .message:empty { display: none; }
  details { margin-top: 0.6rem; font-size: var(--step--1); }
  summary { cursor: pointer; color: var(--salmonberry); min-height: 24px; }
  details p { margin: 0.4rem 0 0; color: var(--muted); }
</style>
