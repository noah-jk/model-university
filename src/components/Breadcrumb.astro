---
interface Props {
  items: { label: string; href: string }[];
}
const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  <ol>
    {
      items.map(({ label, href }, i) => (
        <li>
          <a href={href} aria-current={i === items.length - 1 ? "page" : undefined}>{label}</a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .breadcrumb { font-size: var(--step--1); margin-bottom: 1rem; }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 0.4rem; padding: 0; margin: 0; }
  li:not(:last-child)::after { content: "/"; margin-left: 0.4rem; color: var(--muted); }
</style>
