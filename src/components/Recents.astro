---
// "Recents": the personalization experiment's recently viewed pages and the
// next step in the application journey, in a band below the header. It opens from the
// Recents button in the header's utility row (inside the Menu on small
// screens) and is filled from this tab's session when it opens; see
// src/scripts/recents.ts.
import NextStep from "./NextStep.astro";
import { RECENTS_LABEL } from "../lib/personalization-settings.ts";
---

<section id="recents" class="recents" aria-labelledby="recents-title" hidden>
  <div class="wrap">
    <div class="intro">
      <h2 id="recents-title" tabindex="-1">{RECENTS_LABEL}</h2>
      <p>Based on the pages you've viewed in this tab. <a href="/lab/personalization/">How this works</a></p>
      <button type="button" class="button secondary close">Close</button>
    </div>
    <div class="modules">
      <div class="module">
        <h3 id="recent-heading">Pages you've viewed</h3>
        <div class="sort" role="group" aria-labelledby="recent-heading">
          <button type="button" class="needs-js" data-sort="recent" aria-pressed="true">Recently viewed</button>
          <button type="button" class="needs-js" data-sort="most" aria-pressed="false">Most viewed</button>
        </div>
        <p class="empty">Pages you open in this tab will show up here.</p>
        <ul class="rows recent-list"></ul>
        <details>
          <summary>Why am I seeing this?</summary>
          <p class="recent-why">
            These are the last pages you opened in this tab. They're kept in your browser's session storage, never sent to us, and cleared when you close the
            tab.
          </p>
        </details>
      </div>
      <NextStep />
    </div>
  </div>
</section>

<script>
  import "../scripts/recents.ts";
</script>

<style>
  .recents { background: var(--paper); color: var(--basalt); border-bottom: 1px solid var(--line); box-shadow: inset 0 6px 0 var(--fir); }
  .wrap { padding-block: 1.5rem; }
  .intro { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.5rem 1rem; margin-bottom: 1rem; }
  h2 { font-size: var(--step-2); margin: 0; }
  h2:focus { outline: none; }
  h2:focus-visible { outline: 3px solid var(--focus); }
  .intro p { margin: 0; font-size: var(--step--1); color: var(--muted); flex: 1 1 16rem; }
  .close { margin-left: auto; }
  /* Small screens: heading and Close on one line, the note below */
  @media (max-width: 47.99rem) { .intro p { order: 3; flex-basis: 100%; } }
  .modules { display: grid; gap: 1.5rem 2.5rem; }
  @media (min-width: 48rem) { .modules { grid-template-columns: 1fr 1fr; } }
  h3 { font-family: var(--sans); font-weight: 600; font-size: var(--step-0); margin: 0 0 0.25rem; }
  .sort { display: inline-flex; margin: 0.25rem 0 0.5rem; border: 1px solid var(--line); border-radius: 999px; padding: 2px; }
  .sort button { font: inherit; font-size: var(--step--1); color: var(--basalt); background: none; border: 0; border-radius: 999px; padding: 0.35rem 0.8rem; min-height: 32px; cursor: pointer; }
  .sort button:hover { background: var(--lichen); }
  .sort button[aria-pressed="true"] { background: var(--fir); color: var(--fog); }
  .sort button:focus-visible { outline: 3px solid var(--focus); outline-offset: 2px; }
  .empty { color: var(--muted); margin: 0.25rem 0 0; }
  .rows { list-style: none; padding: 0; margin: 0; }
  .rows :global(li) { max-width: none; display: flex; align-items: center; justify-content: space-between; gap: 0.5rem 1rem; padding-block: 0.5rem; border-bottom: 1px solid var(--line); }
  .rows :global(a) { line-height: 1.3; }
  .rows :global(.meta) { display: block; font-size: var(--step--1); color: var(--muted); line-height: 1.3; }
  .rows :global(.save-toggle) { flex: none; }
  details { margin-top: 0.6rem; font-size: var(--step--1); }
  summary { cursor: pointer; color: var(--salmonberry); min-height: 24px; }
  details p { margin: 0.4rem 0 0; color: var(--muted); }
</style>
