---
// "Your next step": one branded tile for the next step in the application
// journey, with a "Why am I seeing this?" note. Used in the Recents panel and
// on the home page. The markup is the first step as a default; the text, link,
// and icon are filled from this tab's session by src/scripts/next-step.ts.
import { JOURNEY } from "../lib/personalization-settings.ts";

interface Props {
  // Heading level for the (visually hidden) heading, to fit where it's placed
  headingLevel?: "h2" | "h3";
  // Lay the tile out in one row when it has the whole page width
  wide?: boolean;
}
const { headingLevel: Heading = "h3", wide = false } = Astro.props;
const first = JOURNEY[0];
---

<div class:list={["module", "journey", { wide }]} data-next-step>
  <Heading class="visually-hidden">Your next step</Heading>
  <a class="next-tile" href={first.href}>
    <svg class="tree" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16 3 6 17h5l-6 9h22l-6-9h5z" /><path d="M14.5 26h3v3h-3z" /></svg>
    <span class="eyebrow" aria-hidden="true">Your next step <span class="count"></span></span>
    <span class="icon" aria-hidden="true">
      <svg data-icon="explore" class="shown" viewBox="0 0 24 24"><circle cx="12" cy="12" r="9" /><path d="m15.5 8.5-2 5-5 2 2-5z" /></svg>
      <svg data-icon="requestInfo" viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="14" rx="2" /><path d="m3.5 6.5 8.5 6 8.5-6" /></svg>
      <svg data-icon="visit" viewBox="0 0 24 24"><path d="M12 21s-6.5-5.6-6.5-11a6.5 6.5 0 0 1 13 0c0 5.4-6.5 11-6.5 11z" /><circle cx="12" cy="10" r="2.4" /></svg>
      <svg data-icon="apply" viewBox="0 0 24 24"><path d="M14.5 4.5 19.5 9.5 9 20H4v-5z" /><path d="m12.5 6.5 5 5" /></svg>
      <svg data-icon="done" viewBox="0 0 24 24"><path d="m12 3 2.7 5.6 6.1.9-4.4 4.3 1 6.1L12 17l-5.4 2.9 1-6.1-4.4-4.3 6.1-.9z" /></svg>
    </span>
    <span class="title">{first.label}</span>
    <span class="pitch">Find a program that fits you, from nursing to data science.</span>
    <span class="go" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
    </span>
  </a>
  <details>
    <summary>Why am I seeing this?</summary>
    <p class="why">Most students start by exploring programs. Viewing any program page completes this step.</p>
  </details>
</div>

<style>
  /* The next-step tile: brand colors in both light and dark mode */
  .next-tile {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas: "eyebrow eyebrow" "icon title" "pitch pitch" "go go";
    align-items: center;
    gap: 0.6rem 1rem;
    min-height: 15rem;
    padding: clamp(1.25rem, 3vw, 1.75rem);
    border-radius: var(--radius-l);
    background: radial-gradient(120% 140% at 100% 0%, #2c5246 0%, #1d3b34 45%, #142b26 100%);
    color: #f2f4f1;
    text-decoration: none;
    box-shadow: 0 10px 30px rgb(20 43 38 / 0.25), inset 0 0 0 1px rgb(220 229 195 / 0.15);
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }
  .next-tile:hover { transform: translateY(-2px); box-shadow: 0 16px 36px rgb(20 43 38 / 0.32), inset 0 0 0 1px rgb(220 229 195 / 0.3); }
  .next-tile:focus-visible { outline: 3px solid var(--focus); outline-offset: 4px; }
  /* The tree from the logo, oversized and faint, behind everything */
  .tree { position: absolute; z-index: -1; right: -2.5rem; bottom: -3rem; width: 14rem; height: auto; fill: #dce5c3; opacity: 0.09; }
  .eyebrow { grid-area: eyebrow; font-size: var(--step--1); font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase; color: #dce5c3; }
  .count { font-weight: 400; letter-spacing: normal; text-transform: none; opacity: 0.8; }
  .count:not(:empty)::before { content: "· " / ""; }
  .icon { grid-area: icon; display: grid; place-items: center; width: 3.25rem; height: 3.25rem; border-radius: 50%; background: #dce5c3; color: #142b26; }
  .icon svg { display: none; width: 1.6rem; height: 1.6rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  .icon svg.shown { display: block; }
  .title { grid-area: title; font-family: var(--serif); font-size: clamp(1.6rem, 3vw, 2.2rem); line-height: 1.1; color: #fff; }
  .pitch { grid-area: pitch; max-width: 34ch; line-height: 1.45; color: #dce5c3; }
  .go { grid-area: go; justify-self: end; display: grid; place-items: center; width: 2.75rem; height: 2.75rem; border-radius: 50%; border: 1.5px solid rgb(220 229 195 / 0.6); color: #fff; transition: transform 0.18s ease, background 0.18s ease; }
  .go svg { width: 1.3rem; height: 1.3rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .next-tile:hover .go { transform: translateX(4px); background: rgb(220 229 195 / 0.15); }
  @media (prefers-reduced-motion: reduce) {
    .next-tile, .go { transition: none; }
    .next-tile:hover, .next-tile:hover .go { transform: none; }
  }
  /* Full-width placement: icon, text, and arrow in a single row */
  @media (min-width: 48rem) {
    .wide .next-tile {
      grid-template-columns: auto 1fr auto;
      grid-template-areas: "icon eyebrow go" "icon title go" "icon pitch go";
      column-gap: clamp(1.25rem, 3vw, 2.5rem);
      min-height: 0;
      padding-block: clamp(1.5rem, 3vw, 2.25rem);
    }
    .wide .icon { width: 4.5rem; height: 4.5rem; }
    .wide .icon svg { width: 2.2rem; height: 2.2rem; }
    .wide .title { font-size: clamp(2rem, 3.5vw, 2.75rem); }
    .wide .pitch { max-width: 52ch; font-size: var(--step-1); }
    .wide .go { width: 3.5rem; height: 3.5rem; align-self: center; }
    .wide .tree { width: 22rem; right: 4rem; bottom: -6rem; }
  }
  details { margin-top: 0.6rem; font-size: var(--step--1); }
  summary { cursor: pointer; color: var(--salmonberry); min-height: 24px; }
  details p { margin: 0.4rem 0 0; color: var(--muted); }
</style>
