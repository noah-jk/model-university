---
// Floating tab bar for small screens: the four top-level sections, no nesting.
const tabs = [
  { href: "/academics/", label: "Academics", icon: "M12 4 2 9l10 5 8-4v6M6 11.5V16c0 1.5 3 3 6 3s6-1.5 6-3v-4.5" },
  { href: "/admissions/", label: "Admissions", icon: "M9 4h6l1 2h3v14H5V6h3zM9 13l2 2 4-4" },
  { href: "/services/", label: "Services", icon: "M12 21s-8-5-8-11a4.5 4.5 0 0 1 8-2.7A4.5 4.5 0 0 1 20 10c0 6-8 11-8 11z" },
  { href: "/about/", label: "About", icon: "M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18zM12 11v6M12 7.5v.5" },
];
const current = Astro.url.pathname;
---

<nav class="tabbar" aria-label="Sections">
  <ul>
    {
      tabs.map(({ href, label, icon }) => (
        <li>
          <a href={href} aria-current={current.startsWith(href) ? "page" : undefined}>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d={icon} /></svg>
            <span>{label}</span>
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .tabbar { display: none; }
  @media (max-width: 47.99rem) {
    .tabbar {
      display: block; position: fixed; z-index: 20;
      left: max(0.75rem, env(safe-area-inset-left)); right: max(0.75rem, env(safe-area-inset-right));
      bottom: max(0.75rem, env(safe-area-inset-bottom));
      background: var(--fir-deep); color: var(--on-dark); border-radius: 999px;
      box-shadow: 0 6px 24px #0000004d, 0 0 0 1px #dce5c322;
    }
    ul { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); margin: 0; padding: 0.3rem; gap: 0.2rem; }
    a { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 0.15rem; min-height: 52px; padding: 0.35rem 0.25rem; border-radius: 999px; color: inherit; text-decoration: none; font: 600 0.6875rem / 1.1 var(--sans); }
    a[aria-current="page"] { background: #dce5c32e; color: #fff; }
    a:focus-visible { outline: 2px solid #dce5c3; outline-offset: -2px; }
    svg { width: 1.35rem; height: 1.35rem; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
  }
</style>
