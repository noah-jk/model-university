---
// The header's Your Path link with its count: steps to do once there's a
// plan, saved items before that ("Your Path, 5 steps to do" or "Your Path,
// 3 saved" to screen readers), hidden at zero. Hidden without JavaScript,
// since Your Path needs it. The count is drawn before the page is (see
// BaseLayout) and kept up to date by src/scripts/workbench/save.ts.
import { WORKBENCH_LABEL, WORKBENCH_PATH } from "../../lib/workbench/types.ts";

interface Props {
  current?: boolean;
}
const { current } = Astro.props;
---

<a class="workbench-link needs-js" href={WORKBENCH_PATH} data-workbench-link aria-current={current ? "page" : undefined}>
  <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M6.5 3.5h11v17l-5.5-4-5.5 4z"></path></svg>
  <span>{WORKBENCH_LABEL}</span>
  <span class="workbench-count" aria-hidden="true" data-workbench-count hidden></span>
  <span class="visually-hidden" data-workbench-count-text></span>
</a>
