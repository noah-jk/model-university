---
import siteConfig from "../../site.config.ts";

// Main sections, plus a smaller utility row for news, events, and the rest.
const mainNav = [
  { href: "/programs/", label: "Programs" },
  { href: "/courses/", label: "Courses" },
  { href: "/admissions/", label: "Admissions" },
  { href: "/services/", label: "Student services" },
  { href: "/faculty/", label: "Faculty" },
];
const utilityNav = [
  { href: "/events/", label: "Events" },
  { href: "/news/", label: "News" },
  { href: "/about/", label: "About" },
  { href: "/connect/", label: "Connect your AI" },
];
const current = Astro.url.pathname;
const ariaCurrent = (href: string) => (current.startsWith(href) ? "page" : undefined);
---

<header class="site-header">
  <div class="wrap top">
    <a class="brand" href="/">
      <svg viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M16 3 6 17h5l-6 9h22l-6-9h5z" /><path d="M14.5 26h3v3h-3z" /></svg>
      <span>{siteConfig.name}</span>
    </a>
    <nav class="utility" aria-label="Utility">
      <ul>{utilityNav.map(({ href, label }) => <li><a href={href} aria-current={ariaCurrent(href)}>{label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="wrap">
    <nav class="main" aria-label="Main">
      <ul>{mainNav.map(({ href, label }) => <li><a href={href} aria-current={ariaCurrent(href)}>{label}</a></li>)}</ul>
    </nav>
  </div>
  <div class="demo-note">
    <div class="wrap"><p>Demo site with fictional data, built to test connecting a university website to AI assistants.</p></div>
  </div>
</header>

<style>
  .site-header { background: var(--fir-deep); color: var(--on-dark); }
  .top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.5rem 2rem; padding-top: 1rem; }
  .brand { color: inherit; text-decoration: none; font-family: var(--serif); font-size: var(--step-1); display: flex; align-items: center; gap: 0.6rem; }
  .brand svg { width: 30px; height: 30px; flex: none; fill: #dce5c3; }
  ul { list-style: none; display: flex; flex-wrap: wrap; margin: 0; padding: 0; }
  .utility ul { gap: 0.25rem 1.25rem; font-size: var(--step--1); }
  .main ul { gap: 0.25rem 1.75rem; padding-block: 0.75rem 0.9rem; }
  nav a { color: var(--on-dark); text-decoration: none; display: inline-block; padding-block: 0.4rem; border-bottom: 2px solid transparent; }
  .main a { font-weight: 600; }
  nav a:hover, nav a[aria-current="page"] { border-bottom-color: #dce5c3; }
  a:focus-visible { outline-color: #dce5c3; }
  .demo-note { background: var(--lichen); color: var(--basalt); font-size: var(--step--1); }
  .demo-note p { margin-block: 0; padding-block: 0.45rem; max-width: none; }
</style>
