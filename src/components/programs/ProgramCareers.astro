---
// Careers and outcomes on a program page (#60): the top career's numbers,
// its pay range, the careers the program leads to, skills, and employers.
// From careersForProgram() in src/lib/catalog.ts.
import CareerNumbers from "../careers/CareerNumbers.astro";
import { growthText, lower } from "../../lib/careers-page.ts";
import { careersForProgram, departmentOf } from "../../lib/catalog.ts";
import { listText, usd } from "../../lib/format.ts";
import { pagePath } from "../../lib/urls.ts";
import type { Program } from "../../lib/schemas.ts";

interface Props {
  program: Program;
}
const { program: p } = Astro.props;
const careers = careersForProgram(p).slice(0, 4);
const [top] = careers;
const field = departmentOf(p).field;
// Minors and certificates add to a degree, so they support careers rather than lead to them
const supports = p.level === "Minor" || p.level === "Certificate";
const heading = supports ? "Careers this can support" : "Careers and outcomes";
const skills = [...new Map(careers.flatMap((c) => c.skills.filter((s) => s.type !== "common")).map((s) => [s.name, s])).values()].slice(0, 8);
const employers = [...new Set(careers.flatMap((c) => c.employers))].slice(0, 6);
---

<section class="careers" aria-labelledby="careers-title">
  <h2 id="careers-title">{heading}</h2>
  <p>{`${supports ? `${field} can support roles` : "Graduates go on to roles"} like ${listText(careers.map((c) => lower(c.name)).slice(0, 3))}.`}</p>

  <p class="top-career">Top career: <strong>{top.name}</strong></p>
  <CareerNumbers career={top} />

  <h3>Careers {supports ? "it can support" : "this program leads to"}</h3>
  <ul class="career-cards">
    {
      careers.map((c) => (
        <li>
          <p class="career-name">
            <a href={pagePath("careers", c.id)}>{c.name}</a>
          </p>
          <p class="career-summary">{c.summary}</p>
          <p class="career-numbers">
            {usd(c.wages.washington.median)} median · {growthText(c.growth_percent)} growth · {c.education}
          </p>
        </li>
      ))
    }
  </ul>

  <h3>Skills employers look for</h3>
  <ul class="skills">{skills.map((s) => <li>{s.name}</li>)}</ul>

  <h3>Where people in these roles work</h3>
  <ul class="employers">{employers.map((e) => <li>{e}</li>)}</ul>

  <p class="source">Labor market data, {top.region}, {top.vintage}.</p>
</section>

<style>
  .top-career { margin: 1rem 0 0; }
  .career-cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .career-cards li { padding: 1rem 1.1rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-s); }
  .career-cards p { margin: 0; }
  .career-name { font-weight: 700; }
  .career-summary { margin-block: 0.3rem 0.5rem !important; }
  .career-numbers { font-size: var(--step--1); color: var(--muted); }

  .skills, .employers { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .skills li { padding: 0.25rem 0.75rem; border-radius: 999px; background: var(--lichen); color: var(--basalt); font-size: var(--step--1); }
  .employers li { padding: 0.25rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius-s); font-size: var(--step--1); }
  .source { margin-top: 1.25rem; font-size: var(--step--1); color: var(--muted); }
</style>
