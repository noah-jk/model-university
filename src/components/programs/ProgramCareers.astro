---
// Careers and outcomes on a program page (#60): the top career's numbers,
// its pay range, the careers the program leads to, skills, and employers.
// From careersForProgram() in src/lib/catalog.ts.
import { careersForProgram, departmentOf } from "../../lib/catalog.ts";
import { listText, usd } from "../../lib/format.ts";
import type { Program } from "../../lib/schemas.ts";

interface Props {
  program: Program;
}
const { program: p } = Astro.props;
const careers = careersForProgram(p).slice(0, 4);
const [top] = careers;
const field = departmentOf(p).field;
// Minors and certificates add to a degree, so they support careers rather than lead to them
const supports = p.level === "Minor" || p.level === "Certificate";
const heading = supports ? "Careers this can support" : "Careers and outcomes";
const lower = (name: string) => name.charAt(0).toLowerCase() + name.slice(1);
const growth = (n: number) => `${n > 0 ? "+" : n < 0 ? "−" : ""}${Math.abs(n)}%`;
const wa = top.wages.washington;
// The bar runs from the 10th to the 90th percentile; the shaded part is the middle half
const at = (value: number) => `${(((value - wa.p10) / (wa.p90 - wa.p10)) * 100).toFixed(1)}%`;
const skills = [...new Map(careers.flatMap((c) => c.skills.filter((s) => s.type !== "common")).map((s) => [s.name, s])).values()].slice(0, 8);
const employers = [...new Set(careers.flatMap((c) => c.employers))].slice(0, 6);
---

<section class="careers" aria-labelledby="careers-title">
  <h2 id="careers-title">{heading}</h2>
  <p>{`${supports ? `${field} can support roles` : "Graduates go on to roles"} like ${listText(careers.map((c) => lower(c.name)).slice(0, 3))}.`}</p>

  <p class="top-career">Top career: <strong>{top.name}</strong></p>
  <dl class="stats" aria-label={`${top.name}: salary and outlook`}>
    <div>
      <dt>Median salary in Washington</dt>
      <dd>{usd(wa.median)}</dd>
      <dd class="compare">{usd(top.wages.national.median)} nationally</dd>
    </div>
    <div>
      <dt>Projected job growth over 10 years</dt>
      <dd>{growth(top.growth_percent)}</dd>
    </div>
    <div>
      <dt>Job openings a year in Washington</dt>
      <dd>{top.annual_openings.toLocaleString("en-US")}</dd>
    </div>
  </dl>

  <h3>Pay range: {lower(top.name)}</h3>
  <div class="range" aria-hidden="true">
    <span class="middle" style={`left: ${at(wa.p25)}; width: calc(${at(wa.p75)} - ${at(wa.p25)})`}></span>
    <span class="median" style={`left: ${at(wa.median)}`}></span>
  </div>
  <p class="range-labels" aria-hidden="true"><span>{usd(wa.p10)}</span><span>{usd(wa.p90)}</span></p>
  <p>
    Most earn between {usd(wa.p25)} and {usd(wa.p75)} a year in Washington, and half earn more than {usd(wa.median)}. The lowest-paid tenth earn under {usd(wa.p10)}, and
    the top tenth over {usd(wa.p90)}.
  </p>

  <h3>Careers {supports ? "it can support" : "this program leads to"}</h3>
  <ul class="career-cards">
    {
      careers.map((c) => (
        <li>
          <p class="career-name">{c.name}</p>
          <p class="career-summary">{c.summary}</p>
          <p class="career-numbers">
            {usd(c.wages.washington.median)} median · {growth(c.growth_percent)} growth · {c.education}
          </p>
        </li>
      ))
    }
  </ul>

  <h3>Skills employers look for</h3>
  <ul class="skills">{skills.map((s) => <li>{s.name}</li>)}</ul>

  <h3>Where people in these roles work</h3>
  <ul class="employers">{employers.map((e) => <li>{e}</li>)}</ul>

  <p class="source">Labor market data, {top.region}, {top.vintage}.</p>
</section>

<style>
  .top-career { margin: 1rem 0 0; }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr)); gap: 1rem; margin: 0.5rem 0 1.5rem; }
  .stats > div { padding: 1rem 1.1rem; background: var(--paper); border: 1px solid var(--line); border-top: 4px solid var(--fir); border-radius: var(--radius-s); display: flex; flex-direction: column; }
  .stats dt { order: 2; font-size: var(--step--1); color: var(--muted); }
  .stats dd { order: 1; margin: 0 0 0.25rem; font: 700 var(--step-2) / 1.1 var(--serif); color: var(--basalt); }
  .stats dd.compare { order: 3; margin: 0.35rem 0 0; font: 400 var(--step--1) / 1.3 var(--sans); color: var(--muted); }

  .range { position: relative; height: 0.9rem; margin-top: 0.75rem; background: var(--line); border-radius: 999px; }
  .range .middle { position: absolute; top: 0; bottom: 0; background: var(--fir); border-radius: 999px; }
  .range .median { position: absolute; top: -0.3rem; bottom: -0.3rem; width: 4px; margin-left: -2px; background: var(--basalt); border-radius: 2px; }
  .range-labels { display: flex; justify-content: space-between; margin: 0.3rem 0 0.5rem; font-size: var(--step--1); color: var(--muted); }

  .career-cards { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 1rem; }
  .career-cards li { padding: 1rem 1.1rem; background: var(--paper); border: 1px solid var(--line); border-radius: var(--radius-s); }
  .career-cards p { margin: 0; }
  .career-name { font-weight: 700; }
  .career-summary { margin-block: 0.3rem 0.5rem !important; }
  .career-numbers { font-size: var(--step--1); color: var(--muted); }

  .skills, .employers { list-style: none; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .skills li { padding: 0.25rem 0.75rem; border-radius: 999px; background: var(--lichen); color: var(--basalt); font-size: var(--step--1); }
  .employers li { padding: 0.25rem 0.75rem; border: 1px solid var(--line); border-radius: var(--radius-s); font-size: var(--step--1); }
  .source { margin-top: 1.25rem; font-size: var(--step--1); color: var(--muted); }
</style>
